<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="POS_moblie_project.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:POS_moblie_project"
    xmlns:home="clr-namespace:POS_moblie_project.Views.Home"
    xmlns:pos="clr-namespace:POS_moblie_project.Views.POS"
    xmlns:transactions="clr-namespace:POS_moblie_project.Views.Transactions"
    xmlns:stock="clr-namespace:POS_moblie_project.Views.Stock"
    xmlns:reports="clr-namespace:POS_moblie_project.Views.Reports"
    xmlns:settings="clr-namespace:POS_moblie_project.Views.Settings"
    Title="POS_moblie_project">

    <!-- ===================== -->
    <!--      FLYOUT HEADER    -->
    <!-- ===================== -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource LightGreen}" Padding="0">
            <VerticalStackLayout Padding="20,28,20,20" Spacing="0">

                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">

                    <Border WidthRequest="50" HeightRequest="50"
                            Padding="0" StrokeThickness="0"
                            BackgroundColor="{StaticResource LightGreen}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Image Source="logo.png"
                               WidthRequest="52" HeightRequest="52"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                        <Label Text="POS FOR SME"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource BlackColor}"
                               CharacterSpacing="2"/>
                        <Label Text="Management System"
                               FontSize="11"
                               TextColor="{StaticResource Gray300}"
                               CharacterSpacing="0.5"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

                <BoxView HeightRequest="1"
                         BackgroundColor="{StaticResource LightGreen}"
                         Margin="0,18,0,0"/>

            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ===================== -->
    <!--    NAVIGATION ITEMS   -->
    <!-- ===================== -->

    <FlyoutItem Title="Dashboard" Route="home" >
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📈" FontFamily="FontAwesome"
                             Color="{StaticResource NavIcon}" Size="18"/>
        </FlyoutItem.Icon>
        <ShellContent Route="HomePage"
                      ContentTemplate="{DataTemplate home:HomePage}"/>
    </FlyoutItem>

    <FlyoutItem Title="POS" Route="pos">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📠" FontFamily="FontAwesome"
                             Color="{StaticResource NavIcon}" Size="18"/>
        </FlyoutItem.Icon>
        <ShellContent Route="POSPage"
                      ContentTemplate="{DataTemplate pos:POSPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Stock" Route="stock">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📦" FontFamily="FontAwesome"
                         Color="{StaticResource NavIcon}" Size="18"/>
        </FlyoutItem.Icon>
        <ShellContent Route="StockPage"
                  ContentTemplate="{DataTemplate stock:StockPage}"/>
    </FlyoutItem>
    
    <FlyoutItem Title="Transactions History" Route="transactions">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📜" FontFamily="FontAwesome"
                             Color="{StaticResource NavIcon}" Size="18"/>
        </FlyoutItem.Icon>
        <ShellContent Route="TransactionHistoryPage"
                      ContentTemplate="{DataTemplate transactions:TransactionHistoryPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Sales Reports" Route="reports">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📄" FontFamily="FontAwesome"
                             Color="{StaticResource NavIcon}" Size="18"/>
        </FlyoutItem.Icon>
        <ShellContent Route="SalesReportPage"
                      ContentTemplate="{DataTemplate reports:SalesReportPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Profit Report" Route="profitreport">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📊" FontFamily="FontAwesome"
                             Color="{StaticResource NavIcon}" Size="18"/>
        </FlyoutItem.Icon>
        <ShellContent Route="ProfitReportPage"
                      ContentTemplate="{DataTemplate reports:ProfitReportPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Settings" Route="settings">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="⚙️" FontFamily="FontAwesome"
                             Color="{StaticResource NavIcon}" Size="18"/>
        </FlyoutItem.Icon>
        <ShellContent Route="SettingsPage"
                      ContentTemplate="{DataTemplate settings:SettingsPage}"/>
    </FlyoutItem>

    <!-- ===================== -->
    <!--    ITEM TEMPLATE      -->
    <!-- ===================== -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid BackgroundColor="Transparent"
                  HeightRequest="56" Padding="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        WidthRequest="36" HeightRequest="36"
                        BackgroundColor="{StaticResource DarkGreen}"
                        Padding="0" StrokeThickness="0"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Image Source="{Binding FlyoutIcon}"
                           WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="14"
                       TextColor="{StaticResource BlackColor}"
                       VerticalOptions="Center"
                       Margin="4,0,0,0"/>

                <Label Grid.Column="2"
                       Text="›" FontSize="20"
                       TextColor="{StaticResource BlackColor}"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

</Shell>