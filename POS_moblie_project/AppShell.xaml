<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="POS_moblie_project.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:POS_moblie_project"
    xmlns:home="clr-namespace:POS_moblie_project.Views.Home"
    xmlns:pos="clr-namespace:POS_moblie_project.Views.POS"
    xmlns:transactions="clr-namespace:POS_moblie_project.Views.Transactions"
    xmlns:stock="clr-namespace:POS_moblie_project.Views.Stock"
    xmlns:reports="clr-namespace:POS_moblie_project.Views.Reports"
    xmlns:settings="clr-namespace:POS_moblie_project.Views.Settings"
    Title="POS_moblie_project">

    <!-- ===================== -->
    <!--      FLYOUT HEADER    -->
    <!-- ===================== -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#12121A" Padding="0">

            <VerticalStackLayout Padding="20,28,20,20"
                                 Spacing="0">

                <!-- Logo Row -->
                <HorizontalStackLayout Spacing="14"
                                       VerticalOptions="Center">

                    <!-- Logo Badge -->
                    <Border WidthRequest="50"
                            HeightRequest="50"
                            Padding="0"
                            StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                <GradientStop Color="#E8C547" Offset="0"/>
                                <GradientStop Color="#C88A00" Offset="1"/>

                            </LinearGradientBrush>
                        </Border.Background>

                        <Label Text="POS"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#12121A"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                    </Border>

                    <!-- App Title -->
                    <VerticalStackLayout VerticalOptions="Center"
                                         Spacing="3">

                        <Label Text="RETAIL PRO"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#F0F0FA"
                               CharacterSpacing="2"/>

                        <Label Text="Management System"
                               FontSize="11"
                               TextColor="#5A5A70"
                               CharacterSpacing="0.5"/>

                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="#1E1E2E"
                         Margin="0,18,0,0"/>

            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ===================== -->
    <!--    NAVIGATION ITEMS   -->
    <!-- ===================== -->

    <!-- HOME -->
    <FlyoutItem Title="Home"
                 Route="home">

        <FlyoutItem.Icon>
            <FontImageSource Glyph="&#xf015;"
                             FontFamily="FontAwesome"
                             Color="#9090A8"
                             Size="18"/>
        </FlyoutItem.Icon>

        <ShellContent Route="HomePage"
                      ContentTemplate="{DataTemplate home:HomePage}"/>

    </FlyoutItem>

    <!-- POS -->
    <FlyoutItem Title="POS"
                 Route="pos">

        <FlyoutItem.Icon>
            <FontImageSource Glyph="&#xf109;"
                             FontFamily="FontAwesome"
                             Color="#9090A8"
                             Size="18"/>
        </FlyoutItem.Icon>

        <ShellContent Route="POSPage"
                      ContentTemplate="{DataTemplate pos:POSPage}"/>

        <ShellContent Route="CartPage"
                      ContentTemplate="{DataTemplate pos:CartPage}"
                      Shell.FlyoutItemIsVisible="False"/>

    </FlyoutItem>

    <!-- TRANSACTIONS -->
    <FlyoutItem Title="Transactions"
                 Route="transactions">

        <FlyoutItem.Icon>
            <FontImageSource Glyph="&#xf362;"
                             FontFamily="FontAwesome"
                             Color="#9090A8"
                             Size="18"/>
        </FlyoutItem.Icon>

        <ShellContent Route="TransactionHistoryPage"
                      ContentTemplate="{DataTemplate transactions:TransactionHistoryPage}"/>

        <ShellContent Route="TransactionDetailPage"
                      ContentTemplate="{DataTemplate transactions:TransactionDetailPage}"
                      Shell.FlyoutItemIsVisible="False"/>

    </FlyoutItem>

    <!-- STOCK -->
    <FlyoutItem Title="Stock"
                 Route="stock">

        <FlyoutItem.Icon>
            <FontImageSource Glyph="&#xf1b2;"
                             FontFamily="FontAwesome"
                             Color="#9090A8"
                             Size="18"/>
        </FlyoutItem.Icon>

        <ShellContent Route="StockPage"
                      ContentTemplate="{DataTemplate stock:StockPage}"/>

        <ShellContent Route="ProductDetailPage"
                      ContentTemplate="{DataTemplate stock:ProductDetailPage}"
                      Shell.FlyoutItemIsVisible="False"/>

    </FlyoutItem>

    <!-- REPORTS -->
    <FlyoutItem Title="Reports"
                 Route="reports">

        <FlyoutItem.Icon>
            <FontImageSource Glyph="&#xf080;"
                             FontFamily="FontAwesome"
                             Color="#9090A8"
                             Size="18"/>
        </FlyoutItem.Icon>

        <ShellContent Route="SalesReportPage"
                      ContentTemplate="{DataTemplate reports:SalesReportPage}"/>

        <ShellContent Route="ProductSalesDetailPage"
                      ContentTemplate="{DataTemplate reports:ProductSalesDetailPage}"
                      Shell.FlyoutItemIsVisible="False"/>

    </FlyoutItem>

    <!-- SETTINGS -->
    <FlyoutItem Title="Settings"
                 Route="settings">

        <FlyoutItem.Icon>
            <FontImageSource Glyph="&#xf013;"
                             FontFamily="FontAwesome"
                             Color="#9090A8"
                             Size="18"/>
        </FlyoutItem.Icon>

        <ShellContent Route="SettingsPage"
                      ContentTemplate="{DataTemplate settings:SettingsPage}"/>

        <ShellContent Route="ManageCategoryPage"
                      ContentTemplate="{DataTemplate settings:ManageCategoryPage}"
                      Shell.FlyoutItemIsVisible="False"/>

        <ShellContent Route="ManagePasswordPage"
                      ContentTemplate="{DataTemplate settings:ManagePasswordPage}"
                      Shell.FlyoutItemIsVisible="False"/>

    </FlyoutItem>

    <!-- ===================== -->
    <!--    ITEM TEMPLATE      -->
    <!-- ===================== -->
    <Shell.ItemTemplate>
        <DataTemplate>

            <Grid BackgroundColor="Transparent"
                  HeightRequest="56"
                  Padding="12,4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Box -->
                <Border Grid.Column="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="#1C1C28"
                        Padding="0"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Image Source="{Binding FlyoutIcon}"
                           WidthRequest="18"
                           HeightRequest="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                </Border>

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="14"
                       TextColor="#9090A8"
                       VerticalOptions="Center"
                       Margin="4,0,0,0"/>

                <!-- Chevron -->
                <Label Grid.Column="2"
                       Text="›"
                       FontSize="20"
                       TextColor="#3A3A50"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>

            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>


</Shell>