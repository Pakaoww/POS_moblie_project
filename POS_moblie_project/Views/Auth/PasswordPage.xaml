<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             x:Class="POS_moblie_project.Views.Auth.PasswordPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <Grid x:DataType="vm:PasswordViewModel"
          RowDefinitions="Auto,*,Auto"
          Padding="24,40,24,32">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="20" HorizontalOptions="Center">

            <Label Text="POS FOR SME"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#222222" />

            <Label Text="{Binding StatusMessage}"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="{Binding IsError, Converter={StaticResource BoolToErrorColorConverter}}" />

            <!-- x:Name kept for FindByName resolution -->
            <HorizontalStackLayout x:Name="PinDotsLayout"
                                   Spacing="14"
                                   HorizontalOptions="Center">
                <Ellipse WidthRequest="14" HeightRequest="14"
                         Stroke="#888888" StrokeThickness="1.5"
                         Fill="{Binding EnteredPin, Converter={StaticResource PinDotConverter}, ConverterParameter=0}" />
                <Ellipse WidthRequest="14" HeightRequest="14"
                         Stroke="#888888" StrokeThickness="1.5"
                         Fill="{Binding EnteredPin, Converter={StaticResource PinDotConverter}, ConverterParameter=1}" />
                <Ellipse WidthRequest="14" HeightRequest="14"
                         Stroke="#888888" StrokeThickness="1.5"
                         Fill="{Binding EnteredPin, Converter={StaticResource PinDotConverter}, ConverterParameter=2}" />
                <Ellipse WidthRequest="14" HeightRequest="14"
                         Stroke="#888888" StrokeThickness="1.5"
                         Fill="{Binding EnteredPin, Converter={StaticResource PinDotConverter}, ConverterParameter=3}" />
                <Ellipse WidthRequest="14" HeightRequest="14"
                         Stroke="#888888" StrokeThickness="1.5"
                         Fill="{Binding EnteredPin, Converter={StaticResource PinDotConverter}, ConverterParameter=4}" />
                <Ellipse WidthRequest="14" HeightRequest="14"
                         Stroke="#888888" StrokeThickness="1.5"
                         Fill="{Binding EnteredPin, Converter={StaticResource PinDotConverter}, ConverterParameter=5}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Numeric Keypad -->
        <Grid Grid.Row="1"
              RowDefinitions="*,*,*,*"
              ColumnDefinitions="*,*,*"
              RowSpacing="18"
              ColumnSpacing="18"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              MaximumWidthRequest="320">

            <Button Grid.Row="0" Grid.Column="0" Text="1"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="1" />
            <Button Grid.Row="0" Grid.Column="1" Text="2"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="2" />
            <Button Grid.Row="0" Grid.Column="2" Text="3"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="3" />

            <Button Grid.Row="1" Grid.Column="0" Text="4"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="4" />
            <Button Grid.Row="1" Grid.Column="1" Text="5"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="5" />
            <Button Grid.Row="1" Grid.Column="2" Text="6"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="6" />

            <Button Grid.Row="2" Grid.Column="0" Text="7"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="7" />
            <Button Grid.Row="2" Grid.Column="1" Text="8"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="8" />
            <Button Grid.Row="2" Grid.Column="2" Text="9"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="9" />

            <Button Grid.Row="3" Grid.Column="0" Text="⌫"
                    Style="{StaticResource KeypadActionButtonStyle}"
                    Command="{Binding DeleteCommand}" />
            <Button Grid.Row="3" Grid.Column="1" Text="0"
                    Style="{StaticResource KeypadButtonStyle}"
                    Command="{Binding DigitPressedCommand}" CommandParameter="0" />
            <Button Grid.Row="3" Grid.Column="2" Text="OK"
                    Style="{StaticResource KeypadConfirmButtonStyle}"
                    Command="{Binding ConfirmCommand}" />

        </Grid>

        <!-- Cancel button -->
        <Button Grid.Row="2"
                Text="Cancel"
                BackgroundColor="Transparent"
                TextColor="#555555"
                FontSize="16"
                HorizontalOptions="End"
                Command="{Binding CancelCommand}" />

    </Grid>
</ContentPage>