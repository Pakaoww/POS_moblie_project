<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="POS_moblie_project.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="#f6f6f6"
             Title="Dashboard"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <Grid RowDefinitions="Auto,*" Padding="0">

            <VerticalStackLayout Grid.Row="1"
                                 Padding="20,24,20,32"
                                 Spacing="16">

                <!-- POS & Stock Buttons Row -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14"
                      HeightRequest="120">

                    <!-- POS Button -->
                    <Border Grid.Column="0"
                            BackgroundColor="#ffffff"
                            StrokeThickness="0"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#e3e3e3" Offset="0,4"
                                    Radius="12" Opacity="0.6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPosCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="POS"
                               FontSize="17" FontAttributes="Bold"
                               TextColor="#3c3d3c"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Stock Button -->
                    <Border Grid.Column="1"
                            BackgroundColor="#ffffff"
                            StrokeThickness="0"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#e3e3e3" Offset="0,4"
                                    Radius="12" Opacity="0.6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToStockCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Stock"
                               FontSize="17" FontAttributes="Bold"
                               TextColor="#3c3d3c"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                </Grid>

                <!-- Stock Overview Card -->
                <Border BackgroundColor="#ffffff"
                        StrokeThickness="0"
                        Padding="22,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#e3e3e3" Offset="0,4"
                                Radius="12" Opacity="0.6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Stock Overview"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#3c3d3c" />

                        <!-- Total Products -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding TotalProducts}"
                                   FontSize="38" FontAttributes="Bold"
                                   TextColor="#3c3d3c"
                                   VerticalOptions="Center" />
                            <Label Text="Total Products"
                                   FontSize="14" TextColor="#c4c4c4"
                                   VerticalOptions="End"
                                   Margin="0,0,0,6" />
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#e3e3e3"
                                 Margin="0,2" />

                        <!-- Stats Row -->
                        <Grid ColumnDefinitions="*,*">

                            <!-- Low Stock -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#e7f6ce"
                                    StrokeThickness="0"
                                    Padding="12,10"
                                    Margin="0,0,6,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding LowStockItems}"
                                           FontSize="22" FontAttributes="Bold"
                                           TextColor="#3c3d3c" />
                                    <Label Text="Low Stock Items"
                                           FontSize="11" TextColor="#a9d888" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Out of Stock -->
                            <Border Grid.Column="1"
                                    BackgroundColor="#f9e0e0"
                                    StrokeThickness="0"
                                    Padding="12,10"
                                    Margin="6,0,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding OutOfStockItems}"
                                           FontSize="22" FontAttributes="Bold"
                                           TextColor="#3c3d3c" />
                                    <Label Text="Out of Stock"
                                           FontSize="11" TextColor="#d37f8b" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Today Sales Card -->
                <Border BackgroundColor="#ffffff"
                        StrokeThickness="0"
                        Padding="22,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#e3e3e3" Offset="0,4"
                                Radius="12" Opacity="0.6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Today's Sales"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#3c3d3c" />

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <!-- Today Sales Card — ส่วน HorizontalStackLayout ตรงกลาง แก้บรรทัดนี้ -->
                            <Label Text="{Binding TodaySales, Converter={StaticResource PriceFormatConverter}}"
                                   FontSize="28" FontAttributes="Bold"
                                   TextColor="#4ECDC4"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="#e3e3e3"
                                 Margin="0,2" />

                        <Label Text="{Binding TodayTransactions, StringFormat='{0} transactions today'}"
                               FontSize="13" TextColor="#c4c4c4" />

                    </VerticalStackLayout>
                </Border>

                <!-- ══════════════════════════════════════════════════ -->
                <!--  Sales Report Card  — กราฟแท่ง 7 วัน (Microcharts) -->
                <!-- ══════════════════════════════════════════════════ -->
                <Border BackgroundColor="#ffffff"
                        StrokeThickness="0"
                        Padding="22,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#e3e3e3" Offset="0,4"
                                Radius="12" Opacity="0.6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <!-- Header row -->
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Sales Report"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#3c3d3c" />
                                <Label Text="Last 7 days"
                                       FontSize="11" TextColor="#c4c4c4" />
                            </VerticalStackLayout>

                            <!-- ปุ่มไปหน้า Report (ตาม design เดิม) -->
                            <Border Grid.Column="1"
                                    BackgroundColor="#e7f6ce"
                                    StrokeThickness="0"
                                    WidthRequest="36" HeightRequest="36"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToReportsCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text=">"
                                       FontSize="18" TextColor="#a9d888"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="#f0f0f0"
                                 Margin="0,0" />

                        <!--
                            microcharts:ChartView
                            ผูกกับ WeeklyBarChart (Chart object) ที่สร้างใน HomeViewModel
                            ตรงตาม pattern ของ Family Co Finance:
                              <microcharts:ChartView Chart="{Binding MemberTrendChart}" .../>
                        -->
                        <microcharts:ChartView Chart="{Binding WeeklyBarChart}"
                                               HeightRequest="220"
                                               VerticalOptions="Fill"
                                               HorizontalOptions="Fill" />

                    </VerticalStackLayout>
                </Border>

                <!-- Transaction History Card -->
                <Border BackgroundColor="#ffffff"
                        StrokeThickness="0"
                        Padding="22,22">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#e3e3e3" Offset="0,4"
                                Radius="12" Opacity="0.6" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToTransactionsCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Transaction History"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#3c3d3c" />
                            <Label Text="Browse all past transactions"
                                   FontSize="12" TextColor="#c4c4c4" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#fef3dc"
                                StrokeThickness="0"
                                WidthRequest="36" HeightRequest="36"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text=">"
                                   FontSize="18" TextColor="#dfc784"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>