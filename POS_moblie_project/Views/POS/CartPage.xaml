<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             xmlns:converters="clr-namespace:POS_moblie_project.Converters"
             x:Class="POS_moblie_project.Views.POS.CartPage"
             x:DataType="vm:CartViewModel"
             Title="Cart"
             BackgroundColor="White">

    <Grid>

        <!-- STATE 1: CART -->
        <Grid RowDefinitions="*,Auto"
              Padding="16"
              IsVisible="{Binding CurrentState,
                          Converter={StaticResource CartStateConverter},
                          ConverterParameter=Cart}">

            <CollectionView Grid.Row="0"
                            ItemsSource="{Binding CartItems}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Your cart is empty"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="#999999" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartItem">
                        <Border Margin="0,0,0,8" Padding="12"
                                BackgroundColor="#F5F5F7" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding ProductName}"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="#222222" />
                                    <Label FontSize="12" TextColor="#666666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding UnitPrice, Converter={StaticResource PriceFormatConverter}}"/>
                                                <Span Text=" each"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="13" FontAttributes="Bold" TextColor="#4ECDC4">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Subtotal: "/>
                                                <Span Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="6" VerticalOptions="Center">
                                    <Button Grid.Column="0" Text="−"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="18" Padding="0" FontSize="18"
                                            BackgroundColor="#E0E0E5" TextColor="#444444"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=DecreaseItemCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Label Grid.Column="1" Text="{Binding Quantity}"
                                           FontSize="15" FontAttributes="Bold"
                                           WidthRequest="28" HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#222222" />
                                    <Button Grid.Column="2" Text="+"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="18" Padding="0" FontSize="18"
                                            BackgroundColor="#E0E0E5" TextColor="#444444"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=IncreaseItemCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="3" Text="🗑"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="18" Padding="0" FontSize="16"
                                            BackgroundColor="#FFE0E0" TextColor="#E53935"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=RemoveItemCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="8" Padding="0,8,0,0">
                <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="#E0E0E0" />
                <!-- Subtotal -->
                <Label Grid.Row="1" FontSize="15" TextColor="#666666" HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Subtotal: "/>
                            <Span Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Discount % -->
                <VerticalStackLayout Grid.Row="2" IsVisible="{Binding DiscountTypeIsPercent}" Spacing="2">
                    <Label Text="{Binding DiscountValue, StringFormat='Discount: {0}% off'}"
                           FontSize="12" TextColor="#E6820E" HorizontalOptions="End" />
                    <Label FontSize="12" TextColor="#E6820E" HorizontalOptions="End">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Saving: - "/>
                                <Span Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- Discount Amount -->
                <Label Grid.Row="2" IsVisible="{Binding DiscountTypeIsAmount}"
                       FontSize="12" TextColor="#E6820E" HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Discount: - "/>
                            <Span Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- VAT -->
                <Label Grid.Row="3" FontSize="13" TextColor="#666666" IsVisible="{Binding IsVatEnabled}" HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="VAT: "/>
                            <Span Text="{Binding VatAmount, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Discount indicator + toggle button -->
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                    <Button Grid.Column="1"
                            BackgroundColor="Transparent" Padding="0"
                            HorizontalOptions="End"
                            FontSize="13" TextColor="#F4A620"
                            Text="▼ Add Discount"
                            Command="{Binding ToggleDiscountSectionCommand}" />
                </Grid>

                <!-- Discount input panel -->
                <Border Grid.Row="5"
                        IsVisible="{Binding IsDiscountSectionVisible}"
                        BackgroundColor="#FFF8E7" StrokeThickness="0"
                        Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">

                        <!-- % / ฿ toggle -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="% Percent"
                                    HeightRequest="36" CornerRadius="8" FontSize="13"
                                    BackgroundColor="{Binding DiscountTypeIsPercent, Converter={StaticResource DiscountActiveColorConverter}, ConverterParameter=bg}"
                                    TextColor="{Binding DiscountTypeIsPercent, Converter={StaticResource DiscountActiveColorConverter}}"
                                    Command="{Binding SetDiscountTypeCommand}"
                                    CommandParameter="percent" />
                            <Button Grid.Column="1" Text="฿ Amount"
                                    HeightRequest="36" CornerRadius="8" FontSize="13"
                                    BackgroundColor="{Binding DiscountTypeIsAmount, Converter={StaticResource DiscountActiveColorConverter}, ConverterParameter=bg}"
                                    TextColor="{Binding DiscountTypeIsAmount, Converter={StaticResource DiscountActiveColorConverter}}"
                                    Command="{Binding SetDiscountTypeCommand}"
                                    CommandParameter="amount" />
                        </Grid>

                        <!-- Input + Apply -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="White"
                                    StrokeThickness="1" Stroke="#E0E0E0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding DiscountInput}"
                                       Placeholder="0"
                                       Keyboard="Numeric"
                                       FontSize="15"
                                       Margin="8,0"
                                       ReturnCommand="{Binding ApplyDiscountCommand}" />
                            </Border>
                            <Button Grid.Column="1" Text="Apply"
                                    HeightRequest="44" WidthRequest="70"
                                    CornerRadius="8" FontSize="13"
                                    BackgroundColor="#F4A620" TextColor="White"
                                    Command="{Binding ApplyDiscountCommand}" />
                        </Grid>

                        <!-- Applied label (Amount) -->
                        <VerticalStackLayout IsVisible="{Binding DiscountTypeIsAmount}" Spacing="2">
                            <Label FontSize="12" TextColor="#E6820E" HorizontalOptions="End">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Applied: - "/>
                                        <Span Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Applied label (% + จำนวนเงิน) -->
                        <VerticalStackLayout IsVisible="{Binding DiscountTypeIsPercent}" Spacing="2">
                            <Label Text="{Binding DiscountValue, StringFormat='Applied: {0}% off'}"
                                   FontSize="12" TextColor="#E6820E" HorizontalOptions="End" />
                            <Label FontSize="12" TextColor="#E6820E" HorizontalOptions="End">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Saving: - "/>
                                        <Span Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Checkout button -->
                <Button Grid.Row="6"
                        Text="{Binding CheckoutButtonText}"
                        BackgroundColor="#4ECDC4" TextColor="White"
                        FontAttributes="Bold" HeightRequest="50" CornerRadius="10"
                        Command="{Binding CheckoutCommand}" />
            </Grid>
        </Grid>

        <!-- STATE 2: CONFIRM ORDER -->
        <Grid RowDefinitions="Auto,*,Auto"
              Padding="16"
              IsVisible="{Binding CurrentState,
                          Converter={StaticResource CartStateConverter},
                          ConverterParameter=Confirm}">

            <Label Grid.Row="0" Text="Confirm Order"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="#222222" Margin="0,0,0,12" />

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding CartItems}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartItem">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Padding="4,6" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding ProductName}"
                                   FontSize="14" TextColor="#222222"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Quantity, StringFormat='x{0}'}"
                                   FontSize="14" TextColor="#666666"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#222222" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="#E0E0E0" />
                <Label Grid.Row="1" FontSize="14" TextColor="#666666" HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Subtotal: "/>
                            <Span Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Discount % -->
                <Label Grid.Row="2"
                       IsVisible="{Binding DiscountTypeIsPercent}"
                       FontSize="13" TextColor="#E6820E" HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Discount ("/>
                            <Span Text="{Binding DiscountValue}"/>
                            <Span Text="%): -"/>
                            <Span Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <!-- Discount fixed amount -->
                <Label Grid.Row="3" TextColor="#666666" HorizontalOptions="End" FontAttributes="Bold" FontSize="13" IsVisible="{Binding IsVatEnabled}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="VAT: "/>
                            <Span Text="{Binding VatAmount, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Grid.Row="4" TextColor="#E6820E" HorizontalOptions="End" FontSize="13" IsVisible="{Binding DiscountTypeIsAmount}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Discount: "/>
                            <Span Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
              
                <Label Grid.Row="5" TextColor="#222222" HorizontalOptions="End" FontAttributes="Bold" FontSize="18">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Total: "/>
                            <Span Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Grid Grid.Row="6" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Back"
                            BackgroundColor="#E0E0E0" TextColor="#444444"
                            HeightRequest="46" CornerRadius="8"
                            Command="{Binding BackToCartCommand}" />
                    <Button Grid.Column="1" Text="Charge"
                            BackgroundColor="#4ECDC4" TextColor="White"
                            FontAttributes="Bold" HeightRequest="46" CornerRadius="8"
                            Command="{Binding GoToChargeCommand}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- STATE 3: CHARGE KEYPAD -->
        <Grid RowDefinitions="Auto,Auto,*,Auto"
      Padding="20,16,20,20"
      BackgroundColor="White"
      IsVisible="{Binding CurrentState,
                  Converter={StaticResource CartStateConverter},
                  ConverterParameter=Charge}">

            <!-- Header: Due + Total -->
            <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,12">
                <Label Text="Charge"
               FontSize="20" FontAttributes="Bold"
               TextColor="#2d6a2d"/>
                <BoxView HeightRequest="1" Color="#E0E0E0"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Grand Total"
                   FontSize="15" FontAttributes="Bold" TextColor="#222222"
                   VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                   Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"
                   FontSize="15" FontAttributes="Bold" TextColor="#222222"
                   VerticalOptions="Center"/>
                </Grid>
                <Label FontSize="13" TextColor="#E53935" FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Due: "/>
                            <Span Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <BoxView HeightRequest="1" Color="#E0E0E0"/>
            </VerticalStackLayout>

            <!-- Display -->
            <Border Grid.Row="1"
            BackgroundColor="White"
            StrokeThickness="1" Stroke="#E0E0E0"
            Padding="16,12" Margin="0,0,0,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="GIVEN AMOUNT"
                   FontSize="11" TextColor="#AAAAAA" FontAttributes="Bold"/>
                    <Label Text="{Binding MoneyReceivedInput, StringFormat='฿ {0}'}"
                   FontSize="36" FontAttributes="Bold"
                   TextColor="#2d6a2d" HorizontalOptions="End"/>
                    <BoxView HeightRequest="1" Color="#F0F0F0"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Change"
                       FontSize="12" TextColor="#AAAAAA" VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                       Text="{Binding Change, Converter={StaticResource PriceFormatConverter}}"
                       FontSize="16" FontAttributes="Bold" TextColor="#4ECDC4"
                       VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Keypad -->
            <Grid Grid.Row="2"
          RowDefinitions="*,*,*,*"
          ColumnDefinitions="*,*,*,*"
          RowSpacing="8" ColumnSpacing="8">

                <!-- Row 0: 1 2 3 ⌫ -->
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <Label Text="1" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <Label Text="2" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="3"/>
                    </Border.GestureRecognizers>
                    <Label Text="3" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" BackgroundColor="#FFF0F0" StrokeThickness="1" Stroke="#FFD0D0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDeleteCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="⌫" FontSize="20" TextColor="#E53935"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Row 1: 4 5 6 C -->
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="4"/>
                    </Border.GestureRecognizers>
                    <Label Text="4" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="5"/>
                    </Border.GestureRecognizers>
                    <Label Text="5" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="6"/>
                    </Border.GestureRecognizers>
                    <Label Text="6" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" BackgroundColor="#F0F0F0" StrokeThickness="1" Stroke="#E0E0E0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearChargeCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="C" FontSize="20" FontAttributes="Bold" TextColor="#666666"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Row 2: 7 8 9 | EXACT span -->
                <Border Grid.Row="2" Grid.Column="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="7"/>
                    </Border.GestureRecognizers>
                    <Label Text="7" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="8"/>
                    </Border.GestureRecognizers>
                    <Label Text="8" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="9"/>
                    </Border.GestureRecognizers>
                    <Label Text="9" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- EXACT span row 2-3 -->
                <Border Grid.Row="2" Grid.Column="3" Grid.RowSpan="2"
                BackgroundColor="#f0f7e8" StrokeThickness="1" Stroke="#c8e6a0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetExactAmountCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                        <Label Text="EXACT" FontSize="11" FontAttributes="Bold"
                       TextColor="#4a8a3a" HorizontalOptions="Center"/>
                        <Label Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="#4a8a3a" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Row 3: . 0 00 -->
                <Border Grid.Row="3" Grid.Column="0" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="."/>
                    </Border.GestureRecognizers>
                    <Label Text="." FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="0"/>
                    </Border.GestureRecognizers>
                    <Label Text="0" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="2" BackgroundColor="White" StrokeThickness="1" Stroke="#E8E8E8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChargeDigitPressedCommand}" CommandParameter="00"/>
                    </Border.GestureRecognizers>
                    <Label Text="00" FontSize="22" FontAttributes="Bold" TextColor="#222222"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

            </Grid>

            <!-- Bottom: Back + Complete -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Back"
                BackgroundColor="#F0F0F0" TextColor="#444444"
                FontAttributes="Bold" HeightRequest="50" CornerRadius="10"
                Command="{Binding BackToConfirmCommand}"/>
                <Button Grid.Column="1" Text="✓  Complete"
                BackgroundColor="#a9d888" TextColor="White"
                FontAttributes="Bold" HeightRequest="50" CornerRadius="10"
                Command="{Binding ConfirmChargeCommand}"/>
            </Grid>

        </Grid>

        <!-- STATE 4: RECEIPT -->
        <Grid RowDefinitions="*,Auto"
      Padding="20"
      IsVisible="{Binding CurrentState,
                  Converter={StaticResource CartStateConverter},
                  ConverterParameter=Receipt}">

            <Border x:Name="ReceiptContainer"
                    Grid.Row="0"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="10">

                <!-- ✅ ใช้ Grid แทน VerticalStackLayout เพื่อดัน Summary ลงล่าง -->
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Row 0: Header -->
                    <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                        <Label Text="✓ Payment Complete"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="#4ECDC4" HorizontalOptions="Center" />
                        <Label Text="{Binding ReceiptTransactionId, StringFormat='Transaction ID: {0}'}"
                   FontSize="12" TextColor="#666666" HorizontalOptions="Center" />
                        <Label Text="{Binding ReceiptTimestamp, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                   FontSize="12" TextColor="#666666" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Row 1: Items (ขยายเต็มพื้นที่ที่เหลือ) -->
                    <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CartItems}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartItem">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                          Padding="4,6" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding ProductName}"
                               FontSize="14" TextColor="#222222"
                               VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                               Text="{Binding Quantity, StringFormat='x{0}'}"
                               FontSize="14" TextColor="#666666"
                               VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                               Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#222222" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Row 2: Summary (ติดล่าง ชิดปุ่ม) -->
                    <VerticalStackLayout Grid.Row="2" Spacing="4">
                        <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,4" />
                        <StackLayout IsVisible="{Binding DiscountTypeIsPercent}"
                             Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                            <Label FontSize="13" TextColor="#E6820E">
                                <Label.Text>
                                    <MultiBinding StringFormat="Discount ({0}%): -">
                                        <Binding Path="DiscountValue" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"
                                   FontSize="13" TextColor="#E6820E" />
                        </StackLayout>
                        <StackLayout IsVisible="{Binding DiscountTypeIsAmount}"
                             Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                            <Label Text="Discount: -" FontSize="13" TextColor="#E6820E" />
                            <Label Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"
                                   FontSize="13" TextColor="#E6820E" />
                        </StackLayout>
                        <StackLayout IsVisible="{Binding IsVatEnabled}"
                             Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                            <Label Text="VAT: " FontSize="13" TextColor="#666666" />
                            <Label Text="{Binding VatAmount, Converter={StaticResource PriceFormatConverter}}"
                                   FontSize="13" TextColor="#666666" />
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                            <Label Text="Total: " FontSize="18" FontAttributes="Bold" TextColor="#222222" />
                            <Label Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"
                                   FontSize="18" FontAttributes="Bold" TextColor="#222222" />
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                            <Label Text="Change: " FontSize="14" TextColor="#666666" />
                            <Label Text="{Binding Change, Converter={StaticResource PriceFormatConverter}}"
                                   FontSize="14" TextColor="#666666" />
                        </StackLayout>
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- ✅ Buttons อยู่นอก ReceiptContainer จะไม่ถูก Capture -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0"
                Text="{Binding PrintButtonText}"
                BackgroundColor="{Binding PrintButtonColor}"
                TextColor="White"
                FontAttributes="Bold" HeightRequest="50" CornerRadius="10"
                x:Name="PrintReceiptButton"
                Command="{Binding PrintReceiptCommand}" />
                <Button Grid.Column="1"
                Text="🏠  Back to POS"
                BackgroundColor="#4ECDC4" TextColor="White"
                FontAttributes="Bold" HeightRequest="50" CornerRadius="10"
                Command="{Binding GoHomeCommand}" />
            </Grid>

        </Grid>

    </Grid>
</ContentPage>