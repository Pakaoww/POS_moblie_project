<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_moblie_project.Views.POS.ConfirmPaymentPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#80000000">

    <!-- Dim background — tap นอก card เพื่อ cancel -->
    <Grid>

        <BoxView BackgroundColor="#80000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Payment Card -->
        <Border BackgroundColor="White"
                StrokeThickness="0"
                WidthRequest="320"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#00000040" Offset="0,4" Radius="16" Opacity="0.3"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!-- Icon + Title -->
                <Label Text="💳"
                       FontSize="40"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8"/>

                <Label Text="Confirm Payment"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#222222"
                       HorizontalOptions="Center"
                       Margin="0,0,0,16"/>

                <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,0,0,16"/>

                <!-- Summary Card -->
                <Border BackgroundColor="#f0f7e8"
                        Stroke="#c8e6a0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,14"
                        Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="10">

                        <!-- Grand Total -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Total"
                                   FontSize="14" TextColor="#555555"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   x:Name="GrandTotalLabel"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#222222"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#d8edbc"/>

                        <!-- Money Received -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Received"
                                   FontSize="13" TextColor="#777777"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   x:Name="MoneyReceivedLabel"
                                   FontSize="14" TextColor="#444444"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Change -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Change"
                                   FontSize="13" TextColor="#777777"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   x:Name="ChangeLabel"
                                   FontSize="30" FontAttributes="Bold"
                                   TextColor="#4a8a3a"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                    <Button Grid.Column="0"
                            Text="Cancel"
                            BackgroundColor="#F0F0F0"
                            TextColor="#444444"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="10"
                            Clicked="OnCancelClicked"/>

                    <Button Grid.Column="1"
                            Text="Confirm"
                            BackgroundColor="#a9d888"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="10"
                            Clicked="OnConfirmClicked"/>

                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
