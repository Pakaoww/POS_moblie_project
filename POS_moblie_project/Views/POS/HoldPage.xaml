<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             x:Class="POS_moblie_project.Views.POS.HoldPage"
             x:DataType="vm:HoldViewModel"
             Title="Hold"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16"
          RowSpacing="12">

        <!-- =========================
             HEADER
        ========================== -->

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              VerticalOptions="Center">

            <VerticalStackLayout Spacing="2">

                <Label Text="Hold Order"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#222222"/>

                <Label Text="{Binding HoldCount, StringFormat='{0} item(s)'}"
                       FontSize="13"
                       TextColor="#888888"/>

            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="🗑 Clear"
                    BackgroundColor="#FFE0E0"
                    TextColor="#E53935"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    CornerRadius="10"
                    Padding="14,0"
                    Command="{Binding ClearHoldCommand}"/>

        </Grid>

        <!-- =========================
             HOLD LIST
        ========================== -->

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding HoldItems}"
                        SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10">

                    <Label Text="🛒"
                           FontSize="50"
                           HorizontalOptions="Center"/>

                    <Label Text="No hold items"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           HorizontalOptions="Center"/>

                    <Label Text="Items you hold will appear here"
                           FontSize="13"
                           TextColor="#BBBBBB"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:HoldItem">

                    <Border Margin="0,0,0,10"
                            Padding="14"
                            BackgroundColor="#F5F5F7"
                            StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">

                            <!-- Product detail -->
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4">

                                <Label Text="{Binding ProductName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#222222"/>

                                <Label FontSize="13" TextColor="#777777">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding UnitPrice, Converter={StaticResource PriceFormatConverter}}"/>
                                            <Span Text=" each"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label FontSize="14" FontAttributes="Bold" TextColor="#4ECDC4">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Subtotal "/>
                                            <Span Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                            </VerticalStackLayout>

                            <!-- Quantity -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 HorizontalOptions="End">

                                <Grid ColumnDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="6">

                                    <Button Grid.Column="0"
                                            Text="−"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            CornerRadius="17"
                                            Padding="0"
                                            FontSize="18"
                                            BackgroundColor="#E0E0E5"
                                            TextColor="#444444"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HoldViewModel}}, Path=DecreaseItemCommand}"
                                            CommandParameter="{Binding .}"/>

                                    <Label Grid.Column="1"
                                           Text="{Binding Quantity}"
                                           WidthRequest="28"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="#222222"/>

                                    <Button Grid.Column="2"
                                            Text="+"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            CornerRadius="17"
                                            Padding="0"
                                            FontSize="18"
                                            BackgroundColor="#E0E0E5"
                                            TextColor="#444444"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HoldViewModel}}, Path=IncreaseItemCommand}"
                                            CommandParameter="{Binding .}"/>

                                </Grid>

                                <Button Text="Remove"
                                        HeightRequest="34"
                                        CornerRadius="8"
                                        FontSize="12"
                                        BackgroundColor="#FFE0E0"
                                        TextColor="#E53935"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HoldViewModel}}, Path=RemoveItemCommand}"
                                        CommandParameter="{Binding .}"/>

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- =========================
             BOTTOM SUMMARY
        ========================== -->

        <Border Grid.Row="2"
                BackgroundColor="#222222"
                Padding="16"
                StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">

                <!-- Total -->
                <Grid ColumnDefinitions="*,Auto">

                    <Label Text="Total"
                           FontSize="15"
                           TextColor="#CCCCCC"/>

                    <Label Grid.Column="1"
                           Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>

                </Grid>

                <!-- VAT -->
                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding IsVatEnabled}">

                    <Label Text="VAT"
                           FontSize="13"
                           TextColor="#AAAAAA"/>

                    <Label Grid.Column="1"
                           Text="{Binding VatAmount, Converter={StaticResource PriceFormatConverter}}"
                           FontSize="13"
                           TextColor="#AAAAAA"/>

                </Grid>

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <Button Grid.Column="0"
                            Text="Resume"
                            HeightRequest="48"
                            CornerRadius="12"
                            BackgroundColor="#3A3A3A"
                            TextColor="White"
                            FontAttributes="Bold"
                            Command="{Binding ResumeOrderCommand}"/>

                    <Button Grid.Column="1"
                            Text="Checkout"
                            HeightRequest="48"
                            CornerRadius="12"
                            BackgroundColor="#4ECDC4"
                            TextColor="White"
                            FontAttributes="Bold"
                            Command="{Binding CheckoutCommand}"/>

                </Grid>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>