<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             x:Class="POS_moblie_project.Views.POS.HoldPage"
             x:DataType="vm:HoldViewModel"
             Title="Hold Orders"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- ── Header ── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
            <VerticalStackLayout Spacing="2">
                <Label Text="Hold Orders"
                       FontSize="24" FontAttributes="Bold" TextColor="#222222"/>
                <Label Text="{Binding SessionCount, StringFormat='{0} basket(s)'}"
                       FontSize="13" TextColor="#888888"/>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="🗑 Clear All"
                    BackgroundColor="#FFE0E0"
                    TextColor="#E53935"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    CornerRadius="10"
                    Padding="14,0"
                    Command="{Binding ClearAllSessionsCommand}"/>
        </Grid>

        <!-- ── Body ── -->
        <Grid Grid.Row="1" ColumnDefinitions="120,*" ColumnSpacing="12">

            <!-- Session List (ซ้าย) -->
            <Border Grid.Column="0"
                    BackgroundColor="#F5F5F7"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 14"
                    Padding="0">
                <CollectionView ItemsSource="{Binding Sessions}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="8">
                            <Label Text="🛒" FontSize="28"
                                   HorizontalOptions="Center"/>
                            <Label Text="No baskets"
                                   FontSize="11" TextColor="#AAAAAA"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:HoldSession">
                            <Border Margin="6,4"
                                    Padding="8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#FFFFFF">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HoldViewModel}}, Path=SelectSessionCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Label}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="#222222"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TimeLabel}"
                                           FontSize="10" TextColor="#888888"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding ItemCount, StringFormat='{0} items'}"
                                           FontSize="10" TextColor="#AAAAAA"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding Total, Converter={StaticResource PriceFormatConverter}, ConverterParameter=N0}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="#4ECDC4"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Border>

            <!-- Items Panel (ขวา) -->
            <Grid Grid.Column="1"
                  RowDefinitions="*"
                  IsVisible="{Binding HasSelectedSession}">

                <CollectionView ItemsSource="{Binding SelectedItems}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="8">
                            <Label Text="🛒" FontSize="40"
                                   HorizontalOptions="Center"/>
                            <Label Text="Select a basket"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#999999"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:HoldItem">
                            <Border Margin="0,0,0,10"
                                    Padding="14"
                                    BackgroundColor="#F5F5F7"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding ProductName}"
                                               FontSize="16" FontAttributes="Bold"
                                               TextColor="#222222"/>

                                        <Label FontSize="13" TextColor="#777777">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding UnitPrice, Converter={StaticResource PriceFormatConverter}}"/>
                                                    <Span Text=" each"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label FontSize="14" FontAttributes="Bold" TextColor="#4ECDC4">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Subtotal "/>
                                                    <Span Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="8"
                                                         HorizontalOptions="End">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="6">
                                            <Button Grid.Column="0" Text="−"
                                                    WidthRequest="34" HeightRequest="34"
                                                    CornerRadius="17" Padding="0"
                                                    FontSize="18"
                                                    BackgroundColor="#E0E0E5"
                                                    TextColor="#444444"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HoldViewModel}}, Path=DecreaseItemCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Quantity}"
                                                   WidthRequest="28" FontSize="15"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   TextColor="#222222"/>
                                            <Button Grid.Column="2" Text="+"
                                                    WidthRequest="34" HeightRequest="34"
                                                    CornerRadius="17" Padding="0"
                                                    FontSize="18"
                                                    BackgroundColor="#E0E0E5"
                                                    TextColor="#444444"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HoldViewModel}}, Path=IncreaseItemCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                        <Button Text="Remove"
                                                HeightRequest="34" CornerRadius="8"
                                                FontSize="12"
                                                BackgroundColor="#FFE0E0"
                                                TextColor="#E53935"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HoldViewModel}}, Path=RemoveItemCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Grid>

            <!-- Placeholder ถ้าไม่มี session -->
            <VerticalStackLayout Grid.Column="1"
                                 IsVisible="{Binding IsEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10">
                <Label Text="🛒" FontSize="50" HorizontalOptions="Center"/>
                <Label Text="No hold baskets"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#999999" HorizontalOptions="Center"/>
                <Label Text="Hold an order from POS to see it here"
                       FontSize="13" TextColor="#BBBBBB"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>

        <!-- ── Bottom Summary ── -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource BorderColor}"
                Padding="16"
                StrokeThickness="1"
                IsVisible="{Binding HasSelectedSession}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#e3e3e3" Offset="0,4"
                Radius="12" Opacity="0.6" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Total"
                           FontSize="15" TextColor="{StaticResource BlackColor}"/>
                    <Label Grid.Column="1"
                           Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource BlackColor}"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="🗑 Clear"
                            HeightRequest="48" CornerRadius="12"
                            BackgroundColor="#FFE0E0"
                            TextColor="#E53935"
                            FontAttributes="Bold"
                            Command="{Binding ClearHoldCommand}"/>
                    <Button Grid.Column="1"
                            Text="Resume"
                            HeightRequest="48" CornerRadius="12"
                            BackgroundColor="{StaticResource LightGrey}"
                            TextColor="{StaticResource BlackColor}"
                            FontAttributes="Bold"
                            Command="{Binding ResumeOrderCommand}"/>
                    <Button Grid.Column="2"
                            Text="Checkout"
                            HeightRequest="48" CornerRadius="12"
                            BackgroundColor="#a9d888"
                            TextColor="White"
                            FontAttributes="Bold"
                            Command="{Binding CheckoutCommand}"/>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>