<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             x:Class="POS_moblie_project.Views.POS.POSPage"
             x:DataType="vm:POSViewModel"
             Title="POS"
             BackgroundColor="{StaticResource BgColor}">

    <Grid RowDefinitions="*,Auto" RowSpacing="0" BackgroundColor="{StaticResource BgColor}"
          Padding="0,0,0,0">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadProductsCommand}"
                     BackgroundColor="White">
            <CollectionView ItemsSource="{Binding Products}"
                            SelectionMode="None"
                            BackgroundColor="White">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Spacing="8" Padding="16,16,16,0"
                                         BackgroundColor="White">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="#F5F5F7"
                                    Padding="12,4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Entry Placeholder="Enter your product..."
                                       Text="{Binding SearchText}"
                                       BackgroundColor="Transparent"/>
                            </Border>
                            <Button Grid.Column="1" Text="📷" FontSize="18"
                                    WidthRequest="48" HeightRequest="48"
                                    CornerRadius="24" BackgroundColor="#a9d888"
                                    TextColor="White" Padding="0"
                                    Command="{Binding ScanBarcodeCommand}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="#F5F5F7"
                                    Padding="12,4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Picker Title="Category"
                                    ItemsSource="{Binding CategoryFilters}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedCategory}"
                                    BackgroundColor="#F5F5F7"/>
                            </Border>
                            <Button Text="On Hold" FontSize="10" VerticalOptions="Center"
                                    Grid.Column="1"
                                    BackgroundColor="#a9d888" TextColor="Black"
                                    Command="{Binding GoToHoldCommand}"/>
                        </Grid>
                        
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <Label Text="No products available"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="#999999" Margin="16,40"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductWithQuantity">
                        <Border Margin="16,0" Padding="12"
                                BackgroundColor="#F5F5F7" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">
            
                                <!-- รูป -->
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                        BackgroundColor="#E0E0E5" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill"/>
                                </Border>

                                <!-- ชื่อ + ราคา (กว้างขึ้นเพราะ column เป็น *) -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                           TextColor="#222222" LineBreakMode="TailTruncation" MaxLines="1"/>
                                    <Label Text="{Binding Price, Converter={StaticResource PriceFormatConverter}}"
                                           FontSize="12" TextColor="#4ECDC4"/>
                                </VerticalStackLayout>

                                <Grid Grid.Column="2"
                                      ColumnDefinitions="26,20,26,8,44"
                                      ColumnSpacing="3" VerticalOptions="Center">
                                    <Button Grid.Column="0" Text="−"
                                            WidthRequest="30" HeightRequest="30"
                                            MinimumWidthRequest="26" MinimumHeightRequest="26"
                                            CornerRadius="13" Padding="0" FontSize="14"
                                            BackgroundColor="#E0E0E5" TextColor="#444444"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:POSViewModel}}, Path=DecreaseQuantityCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Label Grid.Column="1" Text="{Binding Quantity}"
                                           FontSize="12" FontAttributes="Bold"
                                           WidthRequest="20" HorizontalOptions="Center"
                                           VerticalOptions="Center" HorizontalTextAlignment="Center"
                                           TextColor="#222222"/>
                                    <Button Grid.Column="2" Text="+"
                                            WidthRequest="30" HeightRequest="30"
                                            MinimumWidthRequest="26" MinimumHeightRequest="26"
                                            CornerRadius="13" Padding="0" FontSize="14"
                                            BackgroundColor="#E0E0E5" TextColor="#444444"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:POSViewModel}}, Path=IncreaseQuantityCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <!-- Column 3 เป็น spacer 8px -->
                                    <Button Grid.Column="4" Text="Add"
                                            WidthRequest="44" HeightRequest="28"
                                            CornerRadius="8" Padding="0" FontSize="12"
                                            BackgroundColor="#a9d888" TextColor="White"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:POSViewModel}}, Path=AddToCartCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- Bottom cart bar — ติดด้านล่างเสมอ ไม่ scroll -->
        <Border Grid.Row="1" BackgroundColor="#a9d888"
                Padding="16,12" StrokeThickness="0" Margin="16,8,16,16">
            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="🛒" FontSize="20" VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding CartCount, StringFormat='{0} item(s)'}"
                       FontSize="15" TextColor="Black" VerticalOptions="Center" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Text="Hold"
                        BackgroundColor="White" TextColor="Black"
                        FontAttributes="Bold" HeightRequest="38"
                        Padding="10,0" CornerRadius="8"
                        Command="{Binding AddToHoldCommand}"/>
                <Button Grid.Column="3" Text="Go to cart"
                        BackgroundColor="White" TextColor="Black"
                        FontAttributes="Bold" HeightRequest="38"
                        Padding="14,0" CornerRadius="8"
                        Command="{Binding GoToCartCommand}"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>