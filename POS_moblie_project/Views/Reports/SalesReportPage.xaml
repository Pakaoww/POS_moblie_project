<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             x:Class="POS_moblie_project.Views.Reports.SalesReportPage"
             x:DataType="vm:SalesReportViewModel"
             Title="Sales Report"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="10">

        <!-- Search -->
        <Border Grid.Row="0" BackgroundColor="#F5F5F7"
                Padding="12,4" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Entry Placeholder="Search by name or code..."
                   Text="{Binding SearchText}"
                   BackgroundColor="Transparent" />
        </Border>

        <!-- Date range -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
            <DatePicker Grid.Column="0" Date="{Binding FromDate}"
                        Format="dd/MM/yyyy" BackgroundColor="#F5F5F7" />
            <Label Grid.Column="1" Text="to"
                   VerticalOptions="Center" HorizontalOptions="Center"
                   TextColor="#666666" />
            <DatePicker Grid.Column="2" Date="{Binding ToDate}"
                        Format="dd/MM/yyyy" BackgroundColor="#F5F5F7" />
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0" Text="Search"
                    BackgroundColor="#4ECDC4" TextColor="White"
                    FontAttributes="Bold" HeightRequest="44" CornerRadius="8"
                    Command="{Binding LoadReportCommand}" />
            <Button Grid.Column="1" Text="📊 Export"
                    BackgroundColor="#2ECC71" TextColor="White"
                    FontAttributes="Bold" HeightRequest="44"
                    Padding="12,0" CornerRadius="8"
                    Command="{Binding ExportExcelCommand}" />
        </Grid>

        <!-- Stats -->
        <Border Grid.Row="3" BackgroundColor="#F5F5F7"
                Padding="16,12" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding TotalItemsSold}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="#222222" HorizontalOptions="Center" />
                    <Label Text="Items Sold" FontSize="11" TextColor="#666666"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding TotalProductTypes}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="#222222" HorizontalOptions="Center" />
                    <Label Text="Products" FontSize="11" TextColor="#666666"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding TotalRevenue,
                                  Converter={StaticResource PriceFormatConverter},
                                  ConverterParameter=N0}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="#4ECDC4" HorizontalOptions="Center" />
                    <Label Text="Revenue" FontSize="11" TextColor="#666666"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Report list -->
        <RefreshView Grid.Row="4"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadReportCommand}">
            <CollectionView ItemsSource="{Binding ReportItems}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No sales data found"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="#999999" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SalesReportItem">
                        <Border Margin="0,0,0,8" Padding="12"
                                BackgroundColor="#F5F5F7" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SalesReportViewModel}}, Path=ViewProductDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        WidthRequest="44" HeightRequest="44"
                                        BackgroundColor="#E0E0E5" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding ProductName}"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="#222222" />
                                    <Label Text="{Binding ProductCode, StringFormat='Code: {0}'}"
                                           FontSize="12" TextColor="#666666" />
                                    <StackLayout Orientation="Horizontal" Spacing="2">
                                        <Label Text="Revenue: "
                                               FontSize="12" TextColor="#4ECDC4" />
                                        <Label Text="{Binding TotalRevenue, Converter={StaticResource PriceFormatConverter}}"
                                               FontSize="12" TextColor="#4ECDC4" />
                                    </StackLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="End" Spacing="2">
                                    <Label Text="{Binding TotalQuantity}"
                                           FontSize="22" FontAttributes="Bold"
                                           TextColor="#222222" HorizontalOptions="End" />
                                    <Label Text="Sold" FontSize="11" TextColor="#666666"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>