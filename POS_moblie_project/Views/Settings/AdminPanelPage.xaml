<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels.Settings"
             x:Class="POS_moblie_project.Views.Settings.AdminPanelPage"
             x:DataType="vm:AdminPanelViewModel"
             Title="Admin Panel"
             BackgroundColor="#f6f6f6">

    <ScrollView>
        <StackLayout Padding="16,16,16,32" Spacing="0">

            <!-- Header badge -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#FFF3E0"
                    Padding="12,10"
                    Margin="0,0,0,20">
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="🛡️" FontSize="18" VerticalOptions="Center"/>
                    <StackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Admin Panel"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#E65100"/>
                        <Label Text="Changes apply immediately to all users"
                               FontSize="11" TextColor="#FB8C00"/>
                    </StackLayout>
                </StackLayout>
            </Border>

            <!-- DASHBOARD VISIBILITY -->
            <Label Text="Dashboard Visibility"
                   TextColor="#222222" FontAttributes="Bold"
                   Margin="0,0,0,8"/>

            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Margin="0,0,0,16">
                <Border.Shadow>
                    <Shadow Brush="#e3e3e3" Offset="0,4" Radius="12" Opacity="0.6"/>
                </Border.Shadow>
                <StackLayout Spacing="0" Padding="0,8">

                    <!-- Sales Report -->
                    <StackLayout Orientation="Horizontal" Padding="16,12" Spacing="12">
                        <Label Text="📄" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Sales Report" TextColor="#222222" FontSize="14"/>
                            <Label Text="Show Sales Report on dashboard" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Border WidthRequest="62" HeightRequest="30"
                                StrokeThickness="0"
                                BackgroundColor="{Binding ShowSalesReport, Converter={StaticResource BoolToColorConverter}}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleShowSalesReportCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" Padding="3,0">
                                <Label Text="{Binding ShowSalesReport, Converter={StaticResource BoolToVisibleTextConverter}}"
                                       FontSize="10" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="{Binding ShowSalesReport, Converter={StaticResource BoolToLabelColumnConverter}}"/>
                                <Border WidthRequest="22" HeightRequest="22"
                                        BackgroundColor="White" StrokeThickness="0"
                                        HorizontalOptions="Center" VerticalOptions="Center"
                                        Grid.Column="{Binding ShowSalesReport, Converter={StaticResource BoolToThumbColumnConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                </Border>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="16,0"/>

                    <!-- Profit Report -->
                    <StackLayout Orientation="Horizontal" Padding="16,12" Spacing="12">
                        <Label Text="📊" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Profit Report" TextColor="#222222" FontSize="14"/>
                            <Label Text="Show Profit Report on dashboard" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Border WidthRequest="62" HeightRequest="30"
                                StrokeThickness="0"
                                BackgroundColor="{Binding ShowProfitReport, Converter={StaticResource BoolToColorConverter}}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleShowProfitReportCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" Padding="3,0">
                                <Label Text="{Binding ShowProfitReport, Converter={StaticResource BoolToVisibleTextConverter}}"
                                       FontSize="10" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="{Binding ShowProfitReport, Converter={StaticResource BoolToLabelColumnConverter}}"/>
                                <Border WidthRequest="22" HeightRequest="22"
                                        BackgroundColor="White" StrokeThickness="0"
                                        HorizontalOptions="Center" VerticalOptions="Center"
                                        Grid.Column="{Binding ShowProfitReport, Converter={StaticResource BoolToThumbColumnConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                </Border>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="16,0"/>

                    <!-- Transaction History -->
                    <StackLayout Orientation="Horizontal" Padding="16,12" Spacing="12">
                        <Label Text="📜" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Transaction History" TextColor="#222222" FontSize="14"/>
                            <Label Text="Show Transaction History on dashboard" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Border WidthRequest="62" HeightRequest="30"
                                StrokeThickness="0"
                                BackgroundColor="{Binding ShowTransactionHistory, Converter={StaticResource BoolToColorConverter}}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleShowTransactionHistoryCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" Padding="3,0">
                                <Label Text="{Binding ShowTransactionHistory, Converter={StaticResource BoolToVisibleTextConverter}}"
                                       FontSize="10" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="{Binding ShowTransactionHistory, Converter={StaticResource BoolToLabelColumnConverter}}"/>
                                <Border WidthRequest="22" HeightRequest="22"
                                        BackgroundColor="White" StrokeThickness="0"
                                        HorizontalOptions="Center" VerticalOptions="Center"
                                        Grid.Column="{Binding ShowTransactionHistory, Converter={StaticResource BoolToThumbColumnConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                </Border>
                            </Grid>
                        </Border>
                    </StackLayout>

                </StackLayout>
            </Border>

            <!-- ADMIN PASSWORD -->
            <Label Text="Admin Security"
                   TextColor="#222222" FontAttributes="Bold"
                   Margin="0,0,0,8"/>

            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Margin="0,0,0,16">
                <Border.Shadow>
                    <Shadow Brush="#e3e3e3" Offset="0,4" Radius="12" Opacity="0.6"/>
                </Border.Shadow>
                <StackLayout Orientation="Horizontal" Padding="16,14" Spacing="12">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangeAdminPasswordCommand}"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="🔐" FontSize="20" VerticalOptions="Center"/>
                    <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                        <Label Text="Change Admin Password" TextColor="#222222" FontSize="14"/>
                        <Label Text="Update the Admin Panel access password"
                               TextColor="#888888" FontSize="12"/>
                    </StackLayout>
                    <Label Text="›" FontSize="20" TextColor="#AAAAAA" VerticalOptions="Center"/>
                </StackLayout>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>
