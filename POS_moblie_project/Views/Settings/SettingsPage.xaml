<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels.Settings"
             x:Class="POS_moblie_project.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="#f6f6f6">

    <ScrollView>
        <StackLayout Padding="16,8,16,32" Spacing="0">

            <!-- GENERAL -->
            <Label Text="General Setting"
                   TextColor="#222222" FontAttributes="Bold"
                   Margin="0,0,0,8"/>

            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Margin="0,0,0,16">
                <Border.Shadow>
                    <Shadow Brush="#e3e3e3" Offset="0,4" Radius="12" Opacity="0.6"/>
                </Border.Shadow>
                <StackLayout Spacing="0" Padding="0,8">

                    <!-- Change Password -->
                    <StackLayout Orientation="Horizontal" Padding="16,12" Spacing="12">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}"/>
                        </StackLayout.GestureRecognizers>
                        <Label Text="🔑" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Change Password" TextColor="#222222" FontSize="14"/>
                            <Label Text="Update your PIN" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Label Text="›" FontSize="20" TextColor="#AAAAAA" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="16,0"/>

                    <!-- Manage Category -->
                    <StackLayout Orientation="Horizontal" Padding="16,12" Spacing="12">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ManageCategoryCommand}"/>
                        </StackLayout.GestureRecognizers>
                        <Label Text="📁" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Manage Category" TextColor="#222222" FontSize="14"/>
                            <Label Text="Add, edit or remove categories" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Label Text="›" FontSize="20" TextColor="#AAAAAA" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="16,0"/>

                    <!-- VAT Toggle -->
                    <StackLayout Orientation="Horizontal" Padding="16,12" Spacing="12">
                        <Label Text="📋" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="VAT Rate" TextColor="#222222" FontSize="14"/>
                            <Label Text="Enable VAT on orders" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Border WidthRequest="62" HeightRequest="30"
                                StrokeThickness="0"
                                BackgroundColor="{Binding VatEnabled, Converter={StaticResource BoolToColorConverter}}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleVatCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" Padding="3,0">
                                <Label Text="{Binding VatEnabled, Converter={StaticResource BoolToVisibleTextConverter}}"
                                       FontSize="10" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="{Binding VatEnabled, Converter={StaticResource BoolToLabelColumnConverter}}"/>
                                <Border WidthRequest="22" HeightRequest="22"
                                        BackgroundColor="White" StrokeThickness="0"
                                        HorizontalOptions="Center" VerticalOptions="Center"
                                        Grid.Column="{Binding VatEnabled, Converter={StaticResource BoolToThumbColumnConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#00000040" Offset="0,2" Radius="4" Opacity="0.3"/>
                                    </Border.Shadow>
                                </Border>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!-- VAT Stepper -->
                    <Border BackgroundColor="White"
                            Stroke="#CCCCCC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="4"
                            Margin="16,0,16,12"
                            IsVisible="{Binding VatEnabled}">
                        <StackLayout Orientation="Horizontal" Spacing="0">
                            <Border BackgroundColor="#F5F5F7"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 8"
                                    WidthRequest="44" HeightRequest="44">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DecreaseVatCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="−" TextColor="#222222"
                                       FontSize="22" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <StackLayout HorizontalOptions="FillAndExpand"
                                         VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding VatRateDisplay}"
                                       TextColor="#222222" FontSize="20" FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label Text="Tax Rate" TextColor="#888888" FontSize="10"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                            <Border BackgroundColor="#4ECDC420"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 8"
                                    WidthRequest="44" HeightRequest="44">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IncreaseVatCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="+" TextColor="#4ECDC4"
                                       FontSize="22" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </StackLayout>
                    </Border>

                </StackLayout>
            </Border>

            <!-- CURRENCY -->
            <Label Text="Currency"
                   TextColor="#222222" FontAttributes="Bold"
                   Margin="0,0,0,8"/>

            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Margin="0,0,0,16">
                <Border.Shadow>
                    <Shadow Brush="#e3e3e3" Offset="0,4" Radius="12" Opacity="0.6"/>
                </Border.Shadow>
                <StackLayout Spacing="0" Padding="16,14">

                    <StackLayout Orientation="Horizontal" Spacing="12">
                        <Label Text="💱" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Show Currency Symbol" TextColor="#222222" FontSize="14"/>
                        </StackLayout>
                        <Border WidthRequest="62" HeightRequest="30"
                                StrokeThickness="0"
                                BackgroundColor="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToColorConverter}}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleShowCurrencySymbolCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" Padding="3,0">
                                <Label Text="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToVisibleTextConverter}}"
                                       FontSize="10" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToLabelColumnConverter}}"/>
                                <Border WidthRequest="22" HeightRequest="22"
                                        BackgroundColor="White" StrokeThickness="0"
                                        HorizontalOptions="Center" VerticalOptions="Center"
                                        Grid.Column="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToThumbColumnConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#00000040" Offset="0,2" Radius="4" Opacity="0.3"/>
                                    </Border.Shadow>
                                </Border>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <Border BackgroundColor="White"
                            Stroke="#CCCCCC" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,8" Margin="0,10,0,0"
                            IsVisible="{Binding ShowCurrencySymbol}">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="Symbol" TextColor="#222222"
                                   VerticalOptions="Center" WidthRequest="60"/>
                            <Entry Text="{Binding CurrencySymbol}"
                                   Placeholder="฿" MaxLength="4"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="#222222"
                                   BackgroundColor="Transparent"
                                   HorizontalOptions="FillAndExpand"/>
                            <Label Text="{Binding CurrencySymbol, StringFormat='Preview: {0}100.00'}"
                                   TextColor="#888888" FontSize="13"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <Label IsVisible="{Binding ShowCurrencySymbol, Converter={StaticResource InverseBoolConverter}}"
                           Text="Preview: 100.00"
                           TextColor="#FFAA33" FontSize="12"
                           Margin="0,8,0,0"
                           HorizontalOptions="End"/>

                </StackLayout>
            </Border>

            <!-- ADMIN PANEL -->
            <Label Text="Admin Panel"
                   TextColor="#222222" FontAttributes="Bold"
                   Margin="0,0,0,8"/>

            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Margin="0,0,0,16">
                <Border.Shadow>
                    <Shadow Brush="#e3e3e3" Offset="0,4" Radius="12" Opacity="0.6"/>
                </Border.Shadow>

                <!-- Admin Panel row — กดแล้ว prompt รหัส Admin -->
                <StackLayout Orientation="Horizontal" Padding="16,14" Spacing="12">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAdminPanelCommand}"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="🛡️" FontSize="20" VerticalOptions="Center"/>
                    <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                        <Label Text="Admin Panel" TextColor="#222222" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Manage dashboard visibility · Admin only"
                               TextColor="#888888" FontSize="12"/>
                    </StackLayout>
                    <Label Text="›" FontSize="20" TextColor="#AAAAAA" VerticalOptions="Center"/>
                </StackLayout>

            </Border>

            <!-- Data Management -->
            <Label Text="Data Management"
       TextColor="#222222" FontAttributes="Bold"
       Margin="0,0,0,8"/>

            <Border StrokeShape="RoundRectangle 20"
        StrokeThickness="0"
        BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="#e3e3e3" Offset="0,4" Radius="12" Opacity="0.6"/>
                </Border.Shadow>
                <StackLayout Spacing="0" Padding="16,14">

                    <!-- Backup Database -->
                    <StackLayout Orientation="Horizontal" Padding="0,4" Spacing="12">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackupDatabaseCommand}"/>
                        </StackLayout.GestureRecognizers>
                        <Label Text="💾" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="Fill" Spacing="2" VerticalOptions="Center">
                            <Label Text="Backup Database" TextColor="#222222" FontSize="14"/>
                            <Label Text="Save a copy of the .db3 file" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Label Text="›" FontSize="20" TextColor="#AAAAAA" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,4"/>

                    <!-- Import / Restore -->
                    <StackLayout Orientation="Horizontal" Padding="0,4" Spacing="12">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportDatabaseCommand}"/>
                        </StackLayout.GestureRecognizers>
                        <Label Text="📥" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="Fill" Spacing="2" VerticalOptions="Center">
                            <Label Text="Import / Restore" TextColor="#222222" FontSize="14"/>
                            <Label Text="Restore from a .db3 backup file" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Label Text="›" FontSize="20" TextColor="#AAAAAA" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,4"/>

                    <!-- Reset All Data -->
                    <StackLayout Orientation="Horizontal" Padding="0,4" Spacing="12">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetDataCommand}"/>
                        </StackLayout.GestureRecognizers>
                        <Label Text="🗑️" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="Fill" Spacing="2" VerticalOptions="Center">
                            <Label Text="Reset All Data" TextColor="#E53935" FontSize="14" FontAttributes="Bold"/>
                            <Label Text="Delete all products, transactions and stock" TextColor="#888888" FontSize="12"/>
                        </StackLayout>
                        <Label Text="›" FontSize="20" TextColor="#AAAAAA" VerticalOptions="Center"/>
                    </StackLayout>

                </StackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#4ECDC4"
                               HorizontalOptions="Center"
                               Margin="0,16,0,0"/>

        </StackLayout>
    </ScrollView>
</ContentPage>
