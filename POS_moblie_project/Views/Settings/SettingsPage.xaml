<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_moblie_project.Views.Settings.SettingsPage"
             Title="Settings">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BgPage">#0D0F1A</Color>
            <Color x:Key="BgCard">#161929</Color>
            <Color x:Key="BgInput">#1E2235</Color>
            <Color x:Key="Accent">#FF6B35</Color>
            <Color x:Key="AccentSoft">#FF6B3520</Color>
            <Color x:Key="AccentAmber">#FFAA33</Color>
            <Color x:Key="TextPrimary">#F0F2FF</Color>
            <Color x:Key="TextSecondary">#8890B0</Color>
            <Color x:Key="TextMuted">#454D6E</Color>
            <Color x:Key="Border">#252A42</Color>
            <Color x:Key="Success">#2ECC71</Color>
            <Color x:Key="Danger">#E74C3C</Color>
            <Color x:Key="DangerSoft">#E74C3C15</Color>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="TextColor"        Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"         Value="10"/>
                <Setter Property="FontAttributes"   Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="1.5"/>
                <Setter Property="Margin"           Value="0,20,0,6"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}"/>
                <Setter Property="Stroke"          Value="{StaticResource Border}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape"     Value="RoundRectangle 14"/>
                <Setter Property="Padding"         Value="0"/>
                <Setter Property="Margin"          Value="0,0,0,4"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize"  Value="12"/>
                <Setter Property="Margin"    Value="0,0,0,4"/>
            </Style>

            <Style x:Key="RowTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontSize"  Value="14"/>
            </Style>

            <Style x:Key="RowSub" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize"  Value="11"/>
                <Setter Property="Margin"    Value="0,2,0,0"/>
            </Style>

            <Style x:Key="Chevron" TargetType="Label">
                <Setter Property="TextColor"       Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize"        Value="18"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style x:Key="Divider" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1"/>
                <Setter Property="Color"         Value="{StaticResource Border}"/>
                <Setter Property="Margin"        Value="16,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- ── Title Bar ── -->
    <Shell.TitleView>
        <StackLayout Orientation="Horizontal"
                     Padding="0,0,16,0"
                     VerticalOptions="Center">
            <Label Text="Settings"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="FillAndExpand"/>
        </StackLayout>
    </Shell.TitleView>

    <ScrollView>
        <StackLayout Padding="16,8,16,32" Spacing="0">

            <!-- ══════════════════════════
                 FINANCE & TAX
            ══════════════════════════ -->
            <Label Text="FINANCE &amp; TAX" Style="{StaticResource SectionLabel}"/>

            <Border Style="{StaticResource Card}">
                <StackLayout Spacing="0">

                    <!-- VAT Rate — Toggle + Stepper -->
                    <StackLayout Padding="16,14" Spacing="10">

                        <!-- Row 1: Icon + Label + Toggle -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="📋" FontSize="20" VerticalOptions="Center"/>
                            <StackLayout HorizontalOptions="FillAndExpand"
                                         Spacing="2"
                                         VerticalOptions="Center">
                                <Label Text="VAT Rate"             Style="{StaticResource FieldLabel}"/>
                                <Label Text="Enable VAT on orders" Style="{StaticResource RowSub}"/>
                            </StackLayout>
                            <Switch IsToggled="{Binding VatEnabled}"
                                    OnColor="{StaticResource Accent}"
                                    ThumbColor="White"
                                    VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Row 2: Stepper (visible เมื่อ VatEnabled = true) -->
                        <Border BackgroundColor="{StaticResource BgInput}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="4"
                                IsVisible="{Binding VatEnabled}">
                            <StackLayout Orientation="Horizontal" Spacing="0">

                                <!-- ปุ่ม − -->
                                <Border BackgroundColor="{StaticResource BgCard}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="44"
                                        HeightRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DecreaseVatCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="−"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- แสดงค่า % -->
                                <StackLayout HorizontalOptions="FillAndExpand"
                                             VerticalOptions="Center"
                                             Spacing="2">
                                    <Label Text="{Binding VatRateDisplay}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Tax Rate"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="10"
                                           HorizontalOptions="Center"/>
                                </StackLayout>

                                <!-- ปุ่ม + -->
                                <Border BackgroundColor="{StaticResource AccentSoft}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="44"
                                        HeightRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IncreaseVatCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="+"
                                           TextColor="{StaticResource Accent}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                            </StackLayout>
                        </Border>

                    </StackLayout>
                    <BoxView Style="{StaticResource Divider}"/>

                </StackLayout>
            </Border>

            <!-- ══════════════════════════
                 SECURITY
            ══════════════════════════ -->
            <Label Text="SECURITY" Style="{StaticResource SectionLabel}"/>

            <Border Style="{StaticResource Card}">
                <StackLayout Spacing="0">

                    <!-- Change Password -->
                    <StackLayout Orientation="Horizontal" Padding="16,14" Spacing="12">
                        <Label Text="🔑" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Change Password"          Style="{StaticResource RowTitle}"/>
                            <Label Text="Last updated 30 days ago" Style="{StaticResource RowSub}"/>
                        </StackLayout>
                        <Label Text="›" Style="{StaticResource Chevron}"/>
                    </StackLayout>
                    <BoxView Style="{StaticResource Divider}"/>

                    <!-- PIN Code -->
                    <StackLayout Orientation="Horizontal" Padding="16,14" Spacing="12">
                        <Label Text="🔢" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="PIN Code"               Style="{StaticResource RowTitle}"/>
                            <Label Text="Used for screen unlock" Style="{StaticResource RowSub}"/>
                        </StackLayout>
                        <Label Text="›" Style="{StaticResource Chevron}"/>
                    </StackLayout>

                </StackLayout>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>