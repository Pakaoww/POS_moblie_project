<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels.Settings"
             x:Class="POS_moblie_project.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="#f6f6f6">

    <!-- ── Title Bar ── -->
    <Shell.TitleView>
        <StackLayout Orientation="Horizontal"
                     Padding="0,0,16,0"
                     VerticalOptions="Center">
            <Label Text="Settings"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="FillAndExpand"/>
        </StackLayout>
    </Shell.TitleView>

    <ScrollView>
        <StackLayout Padding="16,8,16,32" Spacing="0">

            <!-- ══════════════════════════
                           TAX
            ══════════════════════════ -->

            <Border Style="{StaticResource Card}"
                    StrokeShape="RoundRectangle 25"
                    BackgroundColor="{StaticResource White}">
                <StackLayout Spacing="0">

                    <!-- VAT Rate — Toggle + Stepper -->
                    <StackLayout Padding="16,14" Spacing="10">



                        <!-- Change Password -->
                        <StackLayout Orientation="Horizontal" Padding="16,14" Spacing="12">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangePasswordCommand}"/>
                            </StackLayout.GestureRecognizers>
                            <Label Text="🔑" FontSize="20" VerticalOptions="Center"/>
                            <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                                <Label Text="Change Password"          Style="{StaticResource RowTitle}"/>
                                <Label Text="Last updated 30 days ago" Style="{StaticResource RowSub}"/>
                            </StackLayout>
                            <Label Text="›" Style="{StaticResource Chevron}"/>
                        </StackLayout>
                        <BoxView Style="{StaticResource Divider}"/>

                        <!-- Manage Category -->
                        <StackLayout Orientation="Horizontal" Padding="16,14" Spacing="12">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ManageCategoryCommand}"/>
                            </StackLayout.GestureRecognizers>
                            <Label Text="📁" FontSize="20" VerticalOptions="Center"/>
                            <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                                <Label Text="Manage Category"               Style="{StaticResource RowTitle}"/>
                                <Label Text="Change Category" Style="{StaticResource RowSub}"/>
                            </StackLayout>
                            <Label Text="›" Style="{StaticResource Chevron}"/>
                        </StackLayout>
                        <BoxView Style="{StaticResource Divider}"/>

                        <!-- Row: Icon + Label + Toggle -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="📋" FontSize="20" VerticalOptions="Center"/>
                            <StackLayout HorizontalOptions="FillAndExpand"
                                         Spacing="2" VerticalOptions="Center">
                                <Label Text="VAT Rate"             Style="{StaticResource FieldLabel}"/>
                                <Label Text="Enable VAT on orders" Style="{StaticResource RowSub}"/>
                            </StackLayout>
                            <Border WidthRequest="62"
                                    HeightRequest="30"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding VatEnabled, Converter={StaticResource BoolToColorConverter}}"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleVatCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,*" Padding="3,0">
                                    <Label Text="{Binding VatEnabled, Converter={StaticResource BoolToVisibleTextConverter}}"
                                           FontSize="10" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           Grid.Column="{Binding VatEnabled, Converter={StaticResource BoolToLabelColumnConverter}}" />
                                    <Border WidthRequest="22" HeightRequest="22"
                                            BackgroundColor="White" StrokeThickness="0"
                                            HorizontalOptions="Center" VerticalOptions="Center"
                                            Grid.Column="{Binding VatEnabled, Converter={StaticResource BoolToThumbColumnConverter}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="11" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#00000040" Offset="0,2" Radius="4" Opacity="0.3" />
                                        </Border.Shadow>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackLayout>

                        <!-- Stepper (visible เมื่อ VatEnabled = true) -->
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource Gray300}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="4"
                                IsVisible="{Binding VatEnabled}">
                            <StackLayout Orientation="Horizontal" Spacing="0">

                                <!-- ปุ่ม − -->
                                <Border BackgroundColor="{StaticResource BgCard}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="44" HeightRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DecreaseVatCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="−"
                                           TextColor="{StaticResource Black}"
                                           FontSize="22" FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- แสดงค่า % -->
                                <StackLayout HorizontalOptions="FillAndExpand"
                                             VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding VatRateDisplay}"
                                           TextColor="{StaticResource Black}"
                                           FontSize="20" FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Tax Rate"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="10"
                                           HorizontalOptions="Center"/>
                                </StackLayout>

                                <!-- ปุ่ม + -->
                                <Border BackgroundColor="{StaticResource AccentSoft}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="44" HeightRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IncreaseVatCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="+"
                                           TextColor="{StaticResource Black}"
                                           FontSize="22" FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                            </StackLayout>
                        </Border>

                    </StackLayout>

                </StackLayout>
            </Border>

            <!-- ══════════════════════════
                 CURRENCY
            ══════════════════════════ -->
            <Label Text="CURRENCY" Style="{StaticResource SectionLabel}"/>

            <Border Style="{StaticResource Card}"
                    StrokeShape="RoundRectangle 25"
                    BackgroundColor="{StaticResource White}">
                <StackLayout Spacing="0" Padding="16,14">

                    <!-- Show/Hide symbol toggle -->
                    <StackLayout Orientation="Horizontal" Spacing="12">
                        <Label Text="💱" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand"
                         Spacing="2" VerticalOptions="Center">
                            <Label Text="Show Currency Symbol" Style="{StaticResource RowTitle}"/>
                        </StackLayout>
                        <Border WidthRequest="62"
        HeightRequest="30"
        StrokeThickness="0"
        BackgroundColor="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToColorConverter}}"
        VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleShowCurrencySymbolCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" Padding="3,0">
                                <Label Text="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToVisibleTextConverter}}"
               FontSize="10" FontAttributes="Bold" TextColor="White"
               HorizontalOptions="Center" VerticalOptions="Center"
               Grid.Column="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToLabelColumnConverter}}" />
                                <Border WidthRequest="22" HeightRequest="22"
                BackgroundColor="White" StrokeThickness="0"
                HorizontalOptions="Center" VerticalOptions="Center"
                Grid.Column="{Binding ShowCurrencySymbol, Converter={StaticResource BoolToThumbColumnConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#00000040" Offset="0,2" Radius="4" Opacity="0.3" />
                                    </Border.Shadow>
                                </Border>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!-- Symbol input (แสดงเมื่อเปิด) -->
                    <Border BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource Gray300}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,8"
                            Margin="0,10,0,0"
                            IsVisible="{Binding ShowCurrencySymbol}">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="Symbol"
                       Style="{StaticResource RowSub}"
                       VerticalOptions="Center"
                       WidthRequest="60"/>
                            <Entry Text="{Binding CurrencySymbol}"
                       Placeholder="฿"
                       MaxLength="4"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextMuted}"
                       BackgroundColor="Transparent"
                       HorizontalOptions="FillAndExpand"/>
                            <Label Text="{Binding CurrencySymbol, StringFormat='Preview: {0}100.00'}"
                       TextColor="{StaticResource AccentAmber}"
                       FontSize="13"
                       VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <!-- Preview เมื่อปิด symbol -->
                    <Label IsVisible="{Binding ShowCurrencySymbol,
                           Converter={StaticResource InverseBoolConverter}}"
               Text="Preview: 100.00"
               TextColor="{StaticResource AccentAmber}"
               FontSize="12"
               Margin="0,8,0,0"
               HorizontalOptions="End"/>

                </StackLayout>
            </Border>

            <!-- ══════════════════════════
                 DATA MANAGEMENT
            ══════════════════════════ -->
            <Label Text="DATA MANAGEMENT" Style="{StaticResource SectionLabel}"/>

            <Border Style="{StaticResource Card}"
                    StrokeShape="RoundRectangle 25"
                    BackgroundColor="{StaticResource White}">
                <StackLayout Spacing="0" Padding="16,14">

                    <!-- Backup Database -->
                    <StackLayout Orientation="Horizontal" Padding="0,4" Spacing="12">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackupDatabaseCommand}"/>
                        </StackLayout.GestureRecognizers>
                        <Label Text="💾" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Backup Database" Style="{StaticResource RowTitle}"/>
                            <Label Text="Save a copy of the .db3 file" Style="{StaticResource RowSub}"/>
                        </StackLayout>
                        <Label Text="›" Style="{StaticResource Chevron}"/>
                    </StackLayout>

                    <BoxView Style="{StaticResource Divider}"/>

                    <!-- Import / Restore -->
                    <StackLayout Orientation="Horizontal" Padding="0,4" Spacing="12">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportDatabaseCommand}"/>
                        </StackLayout.GestureRecognizers>
                        <Label Text="📥" FontSize="20" VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="2" VerticalOptions="Center">
                            <Label Text="Import / Restore" Style="{StaticResource RowTitle}"/>
                            <Label Text="Restore from a .db3 backup file" Style="{StaticResource RowSub}"/>
                        </StackLayout>
                        <Label Text="›" Style="{StaticResource Chevron}"/>
                    </StackLayout>

                </StackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                   IsVisible="{Binding IsBusy}"
                   Color="#FF6B35"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0"/>


        </StackLayout>
    </ScrollView>
</ContentPage>