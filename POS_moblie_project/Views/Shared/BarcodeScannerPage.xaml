<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             x:Class="POS_moblie_project.Views.Shared.BarcodeScannerPage"
             Title="Scan Barcode"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">

        <!-- Camera view -->
        <zxing:CameraBarcodeReaderView
            x:Name="BarcodeReader"
            Grid.Row="0"
            BarcodesDetected="OnBarcodesDetected"
            IsDetecting="True">
            <zxing:CameraBarcodeReaderView.Options>
                <zxing:BarcodeReaderOptions
                    Formats="QrCode,Code128,Code39,Ean13,Ean8,Upca,Upce"
                    AutoRotate="True"
                    Multiple="False" />
            </zxing:CameraBarcodeReaderView.Options>
        </zxing:CameraBarcodeReaderView>

        <!-- Overlay -->
        <Grid Grid.Row="0" InputTransparent="True">

            <BoxView Color="#88000000" />

            <Border WidthRequest="260"
                    HeightRequest="260"
                    BackgroundColor="Transparent"
                    StrokeThickness="3"
                    Stroke="#4ECDC4"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <BoxView Color="Transparent" />
            </Border>

            <BoxView x:Name="ScanLine"
                     Color="#4ECDC4"
                     HeightRequest="2"
                     WidthRequest="240"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Opacity="0.8" />

            <Label Text="Align barcode within the frame"
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,160,0,0" />
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="1"
              BackgroundColor="#12121A"
              Padding="20,16">
            <Button Text="Cancel"
                    BackgroundColor="#2A2A3A"
                    TextColor="White"
                    HeightRequest="46"
                    CornerRadius="10"
                    Clicked="OnCancelClicked" />
        </Grid>

    </Grid>
</ContentPage>