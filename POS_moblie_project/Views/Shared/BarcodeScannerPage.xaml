<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="POS_moblie_project.Views.Shared.BarcodeScannerPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <zxing:CameraBarcodeReaderView
            x:Name="BarcodeReader"
            Grid.Row="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsDetecting="True" />

        <Grid Grid.Row="0"
              InputTransparent="False"
              RowDefinitions="*,260,*"
              ColumnDefinitions="*,260,*">

            <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                     Color="#AA000000" InputTransparent="True" />
            <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                     Color="#AA000000" InputTransparent="True" />
            <BoxView Grid.Row="1" Grid.Column="0"
                     Color="#AA000000" InputTransparent="True" />
            <BoxView Grid.Row="1" Grid.Column="2"
                     Color="#AA000000" InputTransparent="True" />

            <Border Grid.Row="1" Grid.Column="1"
                    BackgroundColor="Transparent"
                    StrokeThickness="3"
                    Stroke="#4ECDC4"
                    InputTransparent="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <BoxView x:Name="ScanLine"
                         Color="#4ECDC4"
                         HeightRequest="2"
                         VerticalOptions="Center"
                         Opacity="0.8"
                         InputTransparent="True" />
            </Border>

            <!-- Status label บนกรอบ -->
            <Label x:Name="StatusLabel"
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="🔍 Opening camera..."
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,0,0,12"
                   InputTransparent="True" />

            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Align barcode within the frame"
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0,12,0,0"
                   InputTransparent="True" />

            <!-- ผลที่อ่านได้ -->
            <Label x:Name="ResultLabel"
                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                   Text=""
                   TextColor="#4ECDC4"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,0,0,8"
                   InputTransparent="True" />

        </Grid>

        <Grid Grid.Row="1"
              BackgroundColor="#12121A"
              Padding="20,16"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">

            <Button Grid.Column="0"
                    Text="🖼 Import"
                    BackgroundColor="#2A3A4A"
                    TextColor="White"
                    HeightRequest="46"
                    CornerRadius="10"
                    Clicked="OnImportClicked" />

            <Button Grid.Column="1"
                    Text="Cancel"
                    BackgroundColor="#2A2A3A"
                    TextColor="White"
                    HeightRequest="46"
                    CornerRadius="10"
                    Clicked="OnCancelClicked" />
        </Grid>

    </Grid>
</ContentPage>