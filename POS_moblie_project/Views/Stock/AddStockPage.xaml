<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             x:Class="POS_moblie_project.Views.Stock.AddStockPage"
             x:DataType="vm:AddStockViewModel"
             Title="เพิ่มสต็อคสินค้าเดิม"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <!-- Search section -->
            <Label Text="ค้นหาสินค้า" FontSize="15" FontAttributes="Bold"
                   TextColor="#222222"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="#F5F5F7"
                        Padding="12,4" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Entry Placeholder="ชื่อสินค้า หรือ Product Code..."
                           Text="{Binding SearchText}"
                           BackgroundColor="Transparent"/>
                </Border>
                <Button Grid.Column="1" Text="📷"
                        FontSize="18" WidthRequest="48" HeightRequest="48"
                        CornerRadius="24" BackgroundColor="#4ECDC4"
                        TextColor="White" Padding="0"
                        Command="{Binding ScanBarcodeCommand}"/>
            </Grid>

            <!-- Search results -->
            <CollectionView ItemsSource="{Binding SearchResults}"
                            SelectionMode="None"
                            MaximumHeightRequest="200"
                            IsVisible="{Binding SearchResults.Count, Converter={StaticResource NullToVisibilityConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Border Margin="0,0,0,4" Padding="12,10"
                                BackgroundColor="#EEF9EE" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddStockViewModel}}, Path=SelectProductCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="#222222"/>
                                    <Label Text="{Binding ProductCode, StringFormat='Code: {0}'}"
                                           FontSize="12" TextColor="#666666"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding SalePrice, StringFormat='฿{0:N2}'}"
                                       FontSize="13" TextColor="#4ECDC4"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Selected product info -->
            <Border BackgroundColor="#F0F9F0" Padding="16,14"
                    StrokeThickness="1" Stroke="#a9d888"
                    IsVisible="{Binding HasSelectedProduct}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="70,*" ColumnSpacing="12">

                    <!-- Image -->
                    <Border Grid.Column="0"
                            WidthRequest="60" HeightRequest="60"
                            BackgroundColor="#E0E0E5" StrokeThickness="0"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Image Source="{Binding ImagePath}" Aspect="AspectFill"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding ProductName}"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="#222222"/>
                            <!-- Clear button -->
                            <Button Grid.Column="1" Text="✕"
                                    FontSize="12"
                                    BackgroundColor="Transparent"
                                    TextColor="#999999"
                                    Padding="4" HeightRequest="28"
                                    Command="{Binding ClearProductCommand}"/>
                        </Grid>

                        <Label Text="{Binding ProductCode, StringFormat='Code: {0}'}"
                               FontSize="12" TextColor="#555555"/>
                        <Label Text="{Binding CategoryName, StringFormat='Category: {0}'}"
                               FontSize="12" TextColor="#555555"/>
                        <Label Text="{Binding SalePrice, StringFormat='Sale Price: ฿{0:N2}'}"
                               FontSize="13" FontAttributes="Bold" TextColor="#4ECDC4"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Lot input section -->
            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"
                     Margin="0,4"
                     IsVisible="{Binding HasSelectedProduct}"/>

            <Label Text="— รายละเอียด Lot ใหม่ —"
                   FontSize="13" FontAttributes="Bold" TextColor="#4ECDC4"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasSelectedProduct}"/>

            <Label Text="Cost Price (ต้นทุน)" FontSize="13" TextColor="#666666"
                   IsVisible="{Binding HasSelectedProduct}"/>
            <Border BackgroundColor="#F5F5F7" Padding="4,0" StrokeThickness="0"
                    IsVisible="{Binding HasSelectedProduct}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding CostPrice}" Keyboard="Numeric"
                       BackgroundColor="Transparent"/>
            </Border>

            <Label Text="Quantity (จำนวน)" FontSize="13" TextColor="#666666"
                   IsVisible="{Binding HasSelectedProduct}"/>
            <Border BackgroundColor="#F5F5F7" Padding="4,0" StrokeThickness="0"
                    IsVisible="{Binding HasSelectedProduct}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding Quantity}" Keyboard="Numeric"
                       BackgroundColor="Transparent"/>
            </Border>

            <!-- Save/Cancel -->
            <Button Text="Save"
                    BackgroundColor="#4ECDC4" TextColor="White"
                    FontAttributes="Bold" HeightRequest="50"
                    CornerRadius="10" Margin="0,20,0,0"
                    IsVisible="{Binding HasSelectedProduct}"
                    Command="{Binding SaveCommand}"/>

            <Button Text="Cancel"
                    BackgroundColor="Transparent" TextColor="#666666"
                    Command="{Binding CancelCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>