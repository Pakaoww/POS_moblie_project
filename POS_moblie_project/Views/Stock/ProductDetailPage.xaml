<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             x:Class="POS_moblie_project.Views.Stock.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <!-- Image preview -->
            <Border WidthRequest="160" HeightRequest="160"
                    BackgroundColor="#F0F0F2" StrokeThickness="0"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Image Source="{Binding ImagePath}" Aspect="AspectFill"/>
            </Border>

            <!-- Photo buttons -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Take Photo" BackgroundColor="#E8E8EA"
                        TextColor="#222222" FontSize="13" Padding="14,8"
                        CornerRadius="8" Command="{Binding TakePhotoCommand}"/>
                <Button Text="Import" BackgroundColor="#E8E8EA"
                        TextColor="#222222" FontSize="13" Padding="14,8"
                        CornerRadius="8" Command="{Binding PickPhotoCommand}"/>
            </HorizontalStackLayout>

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                   IsVisible="{Binding IsLoading}"
                   Color="#9966FF"
                   HorizontalOptions="Center"/>

            <!-- Product Code -->
            <Label Text="Product Code" FontSize="13" TextColor="#666666" Margin="0,10,0,0"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="#F5F5F7"
                        Padding="4,0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding ProductCode}" BackgroundColor="Transparent"/>
                </Border>
                <Button Grid.Column="1" Text="📷"
                        FontSize="18" WidthRequest="48" HeightRequest="48"
                        CornerRadius="8" BackgroundColor="#a9d888"
                        TextColor="White" Padding="0"
                        Command="{Binding ScanBarcodeCommand}"/>
            </Grid>

            <!-- Product Name -->
            <Label Text="Product Name" FontSize="13" TextColor="#666666" Margin="0,10,0,0"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="#F5F5F7" Padding="4,0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding ProductName}" BackgroundColor="Transparent"/>
                </Border>
                <Button Grid.Column="1"
                        Text="🤖"
                        BackgroundColor="#9966FF"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="44"
                        WidthRequest="48"
                        CornerRadius="8"
                        Padding="0"
                        Command="{Binding ScanProductImageCommand}"/>
            </Grid>
            <!-- Category -->
            <Label Text="Category" FontSize="13" TextColor="#666666"/>
            <Border BackgroundColor="#F5F5F7" Padding="4,0" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Picker ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedCategory}"
                        BackgroundColor="Transparent"/>
            </Border>

            <!-- Sale Price -->
            <Label Text="Sale Price" FontSize="13" TextColor="#666666"/>
            <Border BackgroundColor="#F5F5F7" Padding="4,0" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding SalePrice}" Keyboard="Numeric"
                       BackgroundColor="Transparent"/>
            </Border>

            <!-- First lot section — Add mode only -->
            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"
                     Margin="0,10"
                     IsVisible="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"/>

            <Label Text="— First Lot Details —"
                   FontSize="13" FontAttributes="Bold" TextColor="#4ECDC4"
                   HorizontalOptions="Center"
                   IsVisible="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"/>

            <Label Text="Cost Price" FontSize="13" TextColor="#666666"
                   IsVisible="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"/>
            <Border BackgroundColor="#F5F5F7" Padding="4,0" StrokeThickness="0"
                    IsVisible="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding CostPrice}" Keyboard="Numeric"
                       BackgroundColor="Transparent"/>
            </Border>

            <Label Text="Initial Quantity" FontSize="13" TextColor="#666666"
                   IsVisible="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"/>
            <Border BackgroundColor="#F5F5F7" Padding="4,0" StrokeThickness="0"
                    IsVisible="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Text="{Binding InitialQuantity}" Keyboard="Numeric"
                       BackgroundColor="Transparent"/>
            </Border>

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" Text="Delete"
                        BackgroundColor="#E53935" TextColor="White"
                        HeightRequest="46" CornerRadius="8"
                        IsVisible="{Binding IsEditMode}"
                        Command="{Binding DeleteCommand}"/>
                <Button Grid.Column="1" Text="Save"
                        BackgroundColor="#a9d888" TextColor="White"
                        FontAttributes="Bold" HeightRequest="46" CornerRadius="8"
                        Command="{Binding SaveCommand}"/>
            </Grid>

            <Button Text="Cancel" BackgroundColor="Transparent"
                    TextColor="#666666" Command="{Binding CancelCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>