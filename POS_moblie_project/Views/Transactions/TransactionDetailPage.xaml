<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             x:Class="POS_moblie_project.Views.Transactions.TransactionDetailPage"
             x:DataType="vm:TransactionDetailViewModel"
             Title="Receipt"
             BackgroundColor="White">

    <Grid RowDefinitions="*,Auto" Padding="20">

        <!-- Receipt Container -->
        <Border x:Name="ReceiptContainer"
                Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="10">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Row 0: Header -->
                <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                    <Label Text="✓ Payment Complete"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="#4ECDC4" HorizontalOptions="Center" />
                    <Label Text="{Binding TransactionId, StringFormat='Transaction ID: {0}'}"
                           FontSize="12" TextColor="#666666" HorizontalOptions="Center" />
                    <Label Text="{Binding Timestamp, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                           FontSize="12" TextColor="#666666" HorizontalOptions="Center" />
                    <Label Text="(Receipt Copy)"
                           FontSize="12" TextColor="#999999" HorizontalOptions="Center"
                           FontAttributes="Italic" />
                </VerticalStackLayout>

                <!-- Row 1: Items -->
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Items}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionItem">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  Padding="4,6" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding ProductName}"
                                       FontSize="14" TextColor="#222222"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Quantity, StringFormat='x{0}'}"
                                       FontSize="14" TextColor="#666666"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Subtotal, Converter={StaticResource PriceFormatConverter}}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#222222" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Row 2: Summary -->
                <VerticalStackLayout Grid.Row="2" Spacing="4">
                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,4" />

                    <StackLayout IsVisible="{Binding IsDiscountPercent}"
                                 Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                        <Label FontSize="13" TextColor="#E6820E">
                            <Label.Text>
                                <MultiBinding StringFormat="Discount ({0}%): -">
                                    <Binding Path="DiscountValue" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"
                               FontSize="13" TextColor="#E6820E" />
                    </StackLayout>

                    <StackLayout IsVisible="{Binding IsDiscountAmount}"
                                 Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                        <Label Text="Discount: -" FontSize="13" TextColor="#E6820E" />
                        <Label Text="{Binding DiscountAmount, Converter={StaticResource PriceFormatConverter}}"
                               FontSize="13" TextColor="#E6820E" />
                    </StackLayout>

                    <StackLayout IsVisible="{Binding IsVatEnabled}"
                                 Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                        <Label Text="VAT: " FontSize="13" TextColor="#666666" />
                        <Label Text="{Binding VatAmount, Converter={StaticResource PriceFormatConverter}}"
                               FontSize="13" TextColor="#666666" />
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="0" HorizontalOptions="End">
                        <Label Text="Total: " FontSize="18" FontAttributes="Bold" TextColor="#222222" />
                        <Label Text="{Binding GrandTotal, Converter={StaticResource PriceFormatConverter}}"
                               FontSize="18" FontAttributes="Bold" TextColor="#222222" />
                    </StackLayout>
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Bottom Button -->
        <Button Grid.Row="1"
                Text="🖨️  Reprint Receipt"
                BackgroundColor="{Binding ReprintButtonColor}"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="10"
                Margin="0,10,0,0"
                Command="{Binding ReprintReceiptCommand}" />

    </Grid>
</ContentPage>