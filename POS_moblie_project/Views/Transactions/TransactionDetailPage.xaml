<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:POS_moblie_project.ViewModels"
             xmlns:models="clr-namespace:POS_moblie_project.Models"
             x:Class="POS_moblie_project.Views.Transactions.TransactionDetailPage"
             x:DataType="vm:TransactionDetailViewModel"
             Title="Transaction Detail"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Header -->
            <Label Text="{Binding TransactionId, StringFormat='ID: {0}'}"
                   FontSize="16" FontAttributes="Bold" TextColor="#222222" />
            <Label Text="{Binding Timestamp, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                   FontSize="13" TextColor="#666666" />

            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,8" />

            <Label Text="Items:" FontSize="15"
                   FontAttributes="Bold" TextColor="#222222" />

            <!-- Items list -->
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionItem">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Padding="4,6" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding ProductName}"
                                   FontSize="14" TextColor="#222222"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Quantity, StringFormat='x{0}'}"
                                   FontSize="13" TextColor="#666666"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding Subtotal, StringFormat='฿{0:N2}'}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#222222"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,8" />

            <!-- Totals -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Subtotal"
                       FontSize="14" TextColor="#666666" />
                <Label Grid.Column="1"
                       Text="{Binding Subtotal, StringFormat='฿{0:N2}'}"
                       FontSize="14" TextColor="#666666" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVatEnabled}">
                <Label Grid.Column="0"
                       Text="{Binding VatRate, StringFormat='VAT {0}%'}"
                       FontSize="14" TextColor="#666666" />
                <Label Grid.Column="1"
                       Text="{Binding VatAmount, StringFormat='฿{0:N2}'}"
                       FontSize="14" TextColor="#666666" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Total"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#222222" />
                <Label Grid.Column="1"
                       Text="{Binding GrandTotal, StringFormat='฿{0:N2}'}"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#4ECDC4" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>